{
  "mcpServers": {
    "linear": {
      "args": [
        "run",
        "linear"
      ],
      "command": "repose-mcp"
    },
    "sentry": {
      "headers": {
        "Authorization": "Bearer ${SENTRY_TOKEN}"
      },
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    }
  },
  "name": "repose-mcp",
  "version": "1.0.0"
}
