{
  "mcpServers": {
    "linear": {
      "args": [
        "run",
        "linear"
      ],
      "command": "repose-mcp",
      "type": "stdio"
    },
    "sentry": {
      "headers": {
        "Authorization": "Bearer ${SENTRY_TOKEN}"
      },
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    }
  }
}
