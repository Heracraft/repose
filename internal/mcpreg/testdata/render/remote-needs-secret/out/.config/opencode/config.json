{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "linear": {
      "command": [
        "repose-mcp",
        "run",
        "linear"
      ],
      "type": "local"
    },
    "sentry": {
      "headers": {
        "Authorization": "Bearer {env:SENTRY_TOKEN}"
      },
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp"
    }
  }
}
