{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "db": {
      "command": [
        "repose-mcp",
        "run",
        "db"
      ],
      "type": "local"
    },
    "edited": {
      "command": [
        "edited-mcp"
      ],
      "environment": {
        "EDITED_TOKEN": "{env:EDITED_TOKEN}",
        "EXTRA": "1"
      },
      "type": "local"
    },
    "linear": {
      "command": [
        "repose-mcp",
        "run",
        "linear"
      ],
      "type": "local"
    },
    "plain": {
      "command": [
        "repose-mcp",
        "run",
        "plain"
      ],
      "type": "local"
    }
  }
}
