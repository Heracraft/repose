{
  "version": 1,
  "agents": {
    "claude": {
      "user": {
        "events": {
          "type": "sse",
          "url": "https://events.example/sse"
        },
        "partial": {
          "headers": {
            "X-Key": "key-${PARTIAL_KEY}"
          },
          "type": "http",
          "url": "https://partial.example/mcp"
        },
        "sentry": {
          "headers": {
            "Authorization": "Bearer ${SENTRY_TOKEN}",
            "X-Org": "${SENTRY_ORG}",
            "X-Plain": "yes"
          },
          "type": "http",
          "url": "https://mcp.sentry.dev/mcp"
        },
        "socket": {
          "type": "ws",
          "url": "wss://ws.example/mcp"
        }
      }
    },
    "codex": {
      "user": {
        "sentry": {
          "bearer_token_env_var": "SENTRY_TOKEN",
          "env_http_headers": {
            "X-Org": "SENTRY_ORG"
          },
          "http_headers": {
            "X-Plain": "yes"
          },
          "url": "https://mcp.sentry.dev/mcp"
        }
      }
    },
    "gemini": {
      "user": {
        "events": {
          "type": "sse",
          "url": "https://events.example/sse"
        },
        "partial": {
          "headers": {
            "X-Key": "key-${PARTIAL_KEY}"
          },
          "type": "http",
          "url": "https://partial.example/mcp"
        },
        "sentry": {
          "headers": {
            "Authorization": "Bearer ${SENTRY_TOKEN}",
            "X-Org": "${SENTRY_ORG}",
            "X-Plain": "yes"
          },
          "type": "http",
          "url": "https://mcp.sentry.dev/mcp"
        }
      }
    },
    "opencode": {
      "user": {
        "events": {
          "type": "remote",
          "url": "https://events.example/sse"
        },
        "partial": {
          "headers": {
            "X-Key": "key-{env:PARTIAL_KEY}"
          },
          "type": "remote",
          "url": "https://partial.example/mcp"
        },
        "sentry": {
          "headers": {
            "Authorization": "Bearer {env:SENTRY_TOKEN}",
            "X-Org": "{env:SENTRY_ORG}",
            "X-Plain": "yes"
          },
          "type": "remote",
          "url": "https://mcp.sentry.dev/mcp"
        }
      }
    },
    "pi": {
      "user": {
        "events": {
          "url": "https://events.example/sse"
        },
        "partial": {
          "headers": {
            "X-Key": "key-${PARTIAL_KEY}"
          },
          "url": "https://partial.example/mcp"
        },
        "sentry": {
          "headers": {
            "Authorization": "Bearer ${SENTRY_TOKEN}",
            "X-Org": "${SENTRY_ORG}",
            "X-Plain": "yes"
          },
          "url": "https://mcp.sentry.dev/mcp"
        }
      }
    }
  }
}
