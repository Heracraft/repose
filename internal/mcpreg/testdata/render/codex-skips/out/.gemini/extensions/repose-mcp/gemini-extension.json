{
  "mcpServers": {
    "events": {
      "type": "sse",
      "url": "https://events.example/sse"
    },
    "partial": {
      "headers": {
        "X-Key": "key-${PARTIAL_KEY}"
      },
      "type": "http",
      "url": "https://partial.example/mcp"
    },
    "sentry": {
      "headers": {
        "Authorization": "Bearer ${SENTRY_TOKEN}",
        "X-Org": "${SENTRY_ORG}",
        "X-Plain": "yes"
      },
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    }
  },
  "name": "repose-mcp",
  "version": "1.0.0"
}
