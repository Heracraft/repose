{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "command": [
          "chrome-devtools-mcp",
          "--browserUrl",
          "http://127.0.0.1:9224"
        ],
        "type": "local"
      },
      "playwright": {
        "command": [
          "playwright-mcp",
          "--cdp-endpoint",
          "http://127.0.0.1:9224"
        ],
        "type": "local"
      }
    }
  }
}
