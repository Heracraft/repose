{
  "mcpServers": {
    "argref": {
      "args": [
        "run",
        "argref"
      ],
      "command": "repose-mcp",
      "type": "stdio"
    },
    "linear": {
      "args": [
        "run",
        "linear"
      ],
      "command": "repose-mcp",
      "type": "stdio"
    },
    "notion": {
      "headers": {
        "Authorization": "Bearer ${NOTION_TOKEN}"
      },
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "withdefault": {
      "args": [
        "run",
        "withdefault"
      ],
      "command": "repose-mcp",
      "type": "stdio"
    }
  },
  "projects": {
    "/home/dev/app": {
      "mcpServers": {
        "linear": {
          "command": "other"
        },
        "localdb": {
          "args": [
            "/home/dev/app/db"
          ],
          "command": "pg-mcp",
          "type": "stdio"
        }
      }
    },
    "/home/dev/lib": {
      "mcpServers": {
        "localdb": {
          "args": [
            "/home/dev/lib/db"
          ],
          "command": "pg-mcp",
          "type": "stdio"
        }
      }
    }
  }
}
