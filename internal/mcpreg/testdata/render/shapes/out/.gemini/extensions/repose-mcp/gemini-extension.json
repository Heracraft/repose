{
  "mcpServers": {
    "argref": {
      "args": [
        "run",
        "argref"
      ],
      "command": "repose-mcp"
    },
    "linear": {
      "args": [
        "run",
        "linear"
      ],
      "command": "repose-mcp"
    },
    "localdb": {
      "args": [
        "/home/dev/app/db"
      ],
      "command": "pg-mcp"
    },
    "notion": {
      "headers": {
        "Authorization": "Bearer ${NOTION_TOKEN}"
      },
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "withdefault": {
      "args": [
        "run",
        "withdefault"
      ],
      "command": "repose-mcp"
    }
  },
  "name": "repose-mcp",
  "version": "1.0.0"
}
