{
  "mcpServers": {
    "argref": {
      "args": [
        "run",
        "argref"
      ],
      "command": "repose-mcp"
    },
    "linear": {
      "args": [
        "-y",
        "linear-mcp"
      ],
      "command": "npx",
      "env": {
        "LINEAR_TOKEN": "${LINEAR_TOKEN}",
        "MODE": "fast"
      }
    },
    "localdb": {
      "args": [
        "/home/dev/app/db"
      ],
      "command": "pg-mcp"
    },
    "notion": {
      "headers": {
        "Authorization": "Bearer ${NOTION_TOKEN}"
      },
      "url": "https://mcp.notion.com/mcp"
    },
    "withdefault": {
      "args": [
        "run",
        "withdefault"
      ],
      "command": "repose-mcp"
    }
  },
  "skipped": [
    {
      "name": "bad name",
      "reason": "a name repose cannot give a server"
    },
    {
      "name": "run",
      "reason": "a name repose cannot give a server"
    },
    {
      "name": "linear",
      "reason": "another server has this name"
    },
    {
      "name": "localdb",
      "reason": "another server has this name"
    }
  ]
}
