.terraform/
# .terraform.lock.hcl is committed on purpose: it is what makes a plan in CI
# resolve the same provider versions as a plan on a laptop (DECISIONS I-21).
infra/**/*.auto.tfvars
# Per-operator and secret values: addresses, key paths, join tokens.
infra/**/*.local.tfvars

#context for ages
context/

# Go binaries a bare `go build ./...` drops in the checkout; the ones that
# matter are built by nix or run with `go run`.
/seedmetrics
/hostd
/hostdev
/guestd
/gateway
/api
/repose
/repose-admin
/repose-hook

# M3 checks: per-operator addresses and the evidence they write (ops/checks/README.md)
ops/checks/m3.env
ops/checks/out/

# Sub-agent worktrees (Claude Code)
.claude/worktrees/
__pycache__/



