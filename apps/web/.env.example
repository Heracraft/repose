# Build-time env for apps/web (08-dashboard.md 5.1). All PUBLIC_* — nothing
# in this app reads a private env var; see the checklist's rg for that.
PUBLIC_API_URL=https://api.repose.run/v1
# The audience access tokens are asked for. It keeps the old name because
# Logto identifies a resource by an opaque string, not by where the api
# answers (DECISIONS I-1156, I-1158). Unset, it is PUBLIC_API_URL without
# its /v1.
PUBLIC_API_RESOURCE=https://api.repose.herakraft.co
PUBLIC_LOGTO_ENDPOINT=https://accounts.herakraft.co
PUBLIC_LOGTO_APP_ID=osfcu4s5rg0p6tn91lpb8
