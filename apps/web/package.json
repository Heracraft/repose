{
	"name": "web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "cp ../../install.sh static/install.sh && svelte-kit sync && vite build",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit",
		"check-types": "tsc --noEmit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test:integration": "playwright test",
		"test:unit": "vitest run",
		"live": "playwright test --config playwright.live.config.ts",
		"live:auth": "node tests-live/capture-auth.mjs",
		"a11y": "playwright test --config playwright.a11y.config.ts"
	},
	"dependencies": {
		"@logto/browser": "^3.0.14",
		"@replit/codemirror-lang-nix": "^6.0.1",
		"animejs": "^4.5.0",
		"marked": "^15.0.7",
		"svelte-sonner": "^1.0.5"
	},
	"devDependencies": {
		"@codemirror/commands": "^6.9.1",
		"@codemirror/language": "^6.11.4",
		"@codemirror/legacy-modes": "^6.5.4",
		"@codemirror/state": "^6.5.2",
		"@codemirror/view": "^6.38.6",
		"@lezer/highlight": "1.2.3",
		"@playwright/test": "^1.58.2",
		"@repo/eslint-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@sveltejs/adapter-node": "^5.4.1",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.4",
		"@types/node": "^24.12.0",
		"eslint": "^9.39.4",
		"jsdom": "^30.1.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.54.1",
		"svelte-check": "^4.4.5",
		"tailwindcss": "^4.2.4",
		"tslib": "^2.8.1",
		"typescript": "5.9.3",
		"vite": "^8.0.1",
		"vitest": "^4.1.0"
	}
}
