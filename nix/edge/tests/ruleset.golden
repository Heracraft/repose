table inet repose-edge {
  set gw_conns4 { type ipv4_addr; flags dynamic; size 65535; }
  set gw_conns6 { type ipv6_addr; flags dynamic; size 65535; }
  set gw_rate4 { type ipv4_addr; flags dynamic,timeout; timeout 1m; size 65535; }
  set gw_rate6 { type ipv6_addr; flags dynamic,timeout; timeout 1m; size 65535; }
  set pub_conns4 { type ipv4_addr; flags dynamic; size 65535; }
  set pub_conns6 { type ipv6_addr; flags dynamic; size 65535; }
  set pub_rate4 { type ipv4_addr; flags dynamic,timeout; timeout 1m; size 65535; }
  set pub_rate6 { type ipv6_addr; flags dynamic,timeout; timeout 1m; size 65535; }
  counter host_forward_dropped { }
  counter host_input_dropped { }
  chain input {
    type filter hook input priority filter; policy drop;
    iifname "lo" accept
    ct state established,related accept
    ct state invalid drop
    tcp dport 22 ct state new add @gw_conns4 { ip saddr ct count over 64 } counter reject with tcp reset
    tcp dport 22 ct state new add @gw_conns6 { ip6 saddr ct count over 64 } counter reject with tcp reset
    tcp dport 22 ct state new update @gw_rate4 { ip saddr limit rate over 20/second burst 40 packets } counter drop
    tcp dport 22 ct state new update @gw_rate6 { ip6 saddr limit rate over 20/second burst 40 packets } counter drop
    tcp dport 22 accept
    tcp dport 443 ct state new add @pub_conns4 { ip saddr ct count over 256 } counter reject with tcp reset
    tcp dport 443 ct state new add @pub_conns6 { ip6 saddr ct count over 256 } counter reject with tcp reset
    tcp dport 443 ct state new update @pub_rate4 { ip saddr limit rate over 100/second burst 200 packets } counter drop
    tcp dport 443 ct state new update @pub_rate6 { ip6 saddr limit rate over 100/second burst 200 packets } counter drop
    tcp dport 443 accept
    udp dport 51820 accept
    iifname "wg0" ip saddr { 10.255.0.3/32 } tcp dport { 9100, 9102 } accept
    iifname "wg0" ip saddr 10.64.0.0/12 tcp dport 8443 accept
    iifname "wg0" ip saddr { 10.255.0.0/22, 10.64.0.0/12 } icmp type echo-request accept
    iifname "wg0" ip saddr { 10.255.0.0/22, 10.64.0.0/12 } counter name host_input_dropped drop
    ip saddr 10.255.0.0/16 tcp dport 2222 accept
    ip saddr 20.102.97.100/32 tcp dport 2222 accept
    iifname "wg0" ip saddr 10.255.255.1 tcp dport 6081 accept
    iifname "wg0" tcp dport { 9100, 9102 } accept
    iifname "wg0" icmp type echo-request accept
    icmp type { destination-unreachable, time-exceeded, parameter-problem, echo-request } limit rate 5/second accept
    icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
    counter drop
  }
  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state established,related accept
    iifname "wg0" oifname "wg0" ip saddr { 10.255.0.3/32 } tcp dport { 9100, 9101, 2021, 9104, 12345, 443 } accept
    iifname "wg0" oifname "wg0" ip daddr { 10.255.0.3/32 } tcp dport { 3100 } accept
    iifname "wg0" oifname "wg0" ip saddr 10.255.255.1 ip daddr { 10.255.0.3/32 } tcp dport { 9090 } accept
    iifname "wg0" oifname "wg0" ip saddr 10.255.0.0/22 ip daddr 10.255.255.1 tcp dport 8443 accept
    iifname "wg0" oifname "wg0" ip saddr { 10.255.0.0/22, 10.64.0.0/12 } counter name host_forward_dropped drop
    counter drop
  }
  chain output {
    type filter hook output priority filter; policy accept;
  }
}
