#cloud-config
# The control-plane VM: a server managed by the owner's existing Coolify.
#
# Coolify itself is not installed here. The instance on the owner's personal
# server adds this machine under Servers, connects over SSH as root with the
# key in coolify_public_key, installs its proxy, and deploys the api, the
# dashboard, Logto and the platform Postgres onto it (DECISIONS I-83). What
# cloud-init leaves behind is exactly what Coolify's "Validate & configure"
# expects to find: root login by key, Docker Engine with the compose plugin,
# Tailscale installed (not joined), and nothing listening.
#
# This one stays Ubuntu. Coolify refuses NixOS as a managed server
# (DECISIONS R4-2), which is the whole reason this VM is not part of nix/.
#
# Nothing secret belongs in this file: custom_data stays in the Azure VM model
# and is readable through IMDS for the life of the VM. The WireGuard private
# key is therefore generated on the machine at first boot and never leaves it;
# its public half is written to /etc/wireguard/publickey for the operator to
# add as a peer on the edge.
ssh_pwauth: false
# Ubuntu images default to disable_root: true, whose ssh module runs after
# write_files and replaces root's authorized_keys with a forced-command line
# ("Please login as the user azureuser"). That is what the first apply hit.
disable_root: false
package_update: true
# Docker from Docker's own repository, which is what Coolify's server
# validation would install if it found none (get.docker.com); installing it
# here means the readiness check below can prove the machine is ready before
# anyone opens Coolify. Coolify rewrites /etc/docker/daemon.json when it
# takes the server over, so none is written here.
# Tailscale so the owner's Coolify reaches this server over the tailnet
# rather than through a public-IP rule that goes stale when the owner's
# server moves (DECISIONS I-86). Installed only: joining needs an auth key,
# which is a secret, so `tailscale up` is the operator's one command after
# the apply (docs/ops/coolify.md).
apt:
  sources:
    docker:
      source: "deb [arch=amd64 signed-by=$KEY_FILE] https://download.docker.com/linux/ubuntu $RELEASE stable"
      keyid: 9DC858229FC7DD38854AE2D88D81803C0EBFCD88
      keyserver: https://download.docker.com/linux/ubuntu/gpg
    tailscale:
      source: "deb [signed-by=$KEY_FILE] https://pkgs.tailscale.com/stable/ubuntu $RELEASE main"
      keyid: 458CA832957F5868
      keyserver: https://pkgs.tailscale.com/stable/ubuntu/$RELEASE.noarmor.gpg
packages:
  - ca-certificates
  - curl
  - jq
  - wireguard-tools
  - docker-ce
  - docker-ce-cli
  - containerd.io
  - docker-compose-plugin
  - docker-buildx-plugin
  - tailscale
write_files:
  # Operator keys, then the key Coolify connects with. Root, because that is
  # the user Coolify manages a server as; sshd below limits root to keys.
  - path: /root/.ssh/authorized_keys
    owner: root:root
    permissions: "0600"
    content: |
      ${indent(6, authorized_keys)}
      ${coolify_public_key}
  - path: /etc/ssh/sshd_config.d/60-repose.conf
    owner: root:root
    permissions: "0644"
    content: |
      PermitRootLogin prohibit-password
      PasswordAuthentication no
  # Docker starts after the tunnel: api-grpc publishes its plain-HTTP
  # metrics port on the WireGuard address only (10.255.255.1:9104:9103,
  # DECISIONS I-174), and Docker cannot publish on an address that does not
  # exist yet. Wants, not Requires: a VM whose wg0 is not configured yet
  # still starts Docker.
  - path: /etc/systemd/system/docker.service.d/10-repose-wg.conf
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      After=wg-quick@wg0.service
      Wants=wg-quick@wg0.service
  - path: /usr/local/sbin/repose-wg-setup
    owner: root:root
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      # Bring up the control plane's WireGuard peer to the edge, so Prometheus
      # can scrape hosts and the api can reach the edge network
      # (docs/workstreams/11-infra-opentofu.md §2, docs/DESIGN.md §15).
      set -euo pipefail
      umask 077
      install -d -m 0700 /etc/wireguard
      if [ ! -s /etc/wireguard/privatekey ]; then
        wg genkey > /etc/wireguard/privatekey
        wg pubkey < /etc/wireguard/privatekey > /etc/wireguard/publickey
        chmod 0600 /etc/wireguard/privatekey
        chmod 0644 /etc/wireguard/publickey
      fi
      if [ -z "${edge_public_key}" ]; then
        echo "repose: edge WireGuard public key not set yet; wg0 left down." >&2
        echo "repose: add this machine to the edge as a peer:" >&2
        echo "repose:   public key $(cat /etc/wireguard/publickey)  allowed-ips ${wireguard_address}" >&2
        exit 0
      fi
      # ListenPort is fixed, not ephemeral (DECISIONS I-866): the edge
      # learns this machine's endpoint from the packets it sends, so a
      # restart on a new random port leaves the edge answering the old
      # one, and only this side can repair the tunnel. On 2026-10-26 it
      # could not, and the gateway had no /internal for 9 hours.
      cat > /etc/wireguard/wg0.conf <<CONF
      [Interface]
      Address = ${wireguard_address}
      ListenPort = 51820
      PostUp = wg set %i private-key /etc/wireguard/privatekey

      [Peer]
      PublicKey = ${edge_public_key}
      Endpoint = ${edge_endpoint}
      AllowedIPs = ${wireguard_allowed_ips}
      PersistentKeepalive = 25
      CONF
      chmod 0600 /etc/wireguard/wg0.conf
      systemctl enable --now wg-quick@wg0
runcmd:
  - [ chmod, "0700", /root/.ssh ]
  - [ systemctl, restart, ssh ]
  - [ systemctl, enable, --now, docker ]
  - [ /usr/local/sbin/repose-wg-setup ]
