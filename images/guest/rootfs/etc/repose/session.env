# The environment every process of dev's sees (guest-conventions.md
# "Environment", nix/guest/base/env.nix). Read by PAM (/etc/environment),
# dev's user manager (/etc/environment.d) and /etc/profile.d/repose.sh.
LANG=C.UTF-8
EDITOR=nvim
REPOSE=1
COLORTERM=truecolor
NPM_CONFIG_PREFIX=/home/dev/.npm-global
PNPM_HOME=/home/dev/.local/share/pnpm
COREPACK_ENABLE_DOWNLOAD_PROMPT=0
GOPATH=/home/dev/go
CARGO_HOME=/home/dev/.cargo
RUSTUP_HOME=/home/dev/.rustup
BUN_INSTALL=/home/dev/.bun
DENO_INSTALL_ROOT=/home/dev/.deno
COMPOSER_HOME=/home/dev/.config/composer
GEM_HOME=/home/dev/.local/share/gem
PIPX_DEFAULT_PYTHON=/usr/bin/python3
BASH_ENV=/etc/repose/bash-env.sh
PLAYWRIGHT_BROWSERS_PATH=/home/dev/.cache/ms-playwright
PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=1
PUPPETEER_SKIP_DOWNLOAD=1
PUPPETEER_EXECUTABLE_PATH=/usr/local/bin/chromium
CHROME_BIN=/usr/local/bin/chromium
BROWSER=/usr/local/libexec/repose/repose-print-url
PATH=/home/dev/.local/share/mise/shims:/home/dev/.local/bin:/home/dev/.local/share/pnpm/bin:/home/dev/.local/share/pnpm:/home/dev/.npm-global/bin:/home/dev/go/bin:/home/dev/.cargo/bin:/home/dev/.bun/bin:/home/dev/.deno/bin:/home/dev/.yarn/bin:/home/dev/.local/share/gem/bin:/home/dev/.config/composer/vendor/bin:/home/dev/.dotnet/tools:/home/dev/.ghcup/bin:/home/dev/.cabal/bin:/home/dev/.opam/default/bin:/home/dev/.luarocks/bin:/home/dev/.mix/escripts:/home/dev/.nimble/bin:/home/dev/.juliaup/bin:/home/dev/.julia/bin:/home/dev/.krew/bin:/home/dev/.volta/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
