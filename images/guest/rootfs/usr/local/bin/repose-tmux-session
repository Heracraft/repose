#!/usr/bin/env bash
# Ported from nix/guest/base for the erofs guest (DECISIONS I-1466).
set -o errexit
set -o nounset
set -o pipefail

project="$HOME/.repose/project.json"
# Exit 3: nothing for the unit to keep running. A failed start is
# never restarted (Restart=on-success), so a start that leaves no
# tmux server in the unit's cgroup ends there instead of starting
# again every 5 s (DECISIONS I-560).
if [ ! -s "$project" ]; then
  echo "repose-tmux-session: $project missing; nothing to do" >&2
  exit 3
fi
slug=$(jq -r '.slug // empty' "$project")
if [ -z "$slug" ]; then
  echo "repose-tmux-session: project.json has no slug" >&2
  exit 1
fi
dir=$(repose-checkout)
created=""
if ! tmux has-session -t "=$slug" 2>/dev/null; then
  # -d: detached. A server this starts runs in the unit's cgroup.
  tmux new-session -d -s "$slug" -n shell -c "$dir"
  created=1
fi
# Run by the unit, the session must belong to a server in the
# unit's cgroup. A server someone started outside it (`tmux` in an
# ssh terminal while the unit waited to restart) answers on the same
# socket: has-session finds the session there, or new-session adds
# it there, and the unit would be left with nothing to supervise.
# Run by hand (from a pane, say), the script skips the check.
self_cg=$(cat /proc/self/cgroup)
if [ "${self_cg%/repose-tmux-session.service}" != "$self_cg" ]; then
  server=$(tmux display-message -p -t "=$slug:" '#{pid}' 2>/dev/null || true)
  if [ -z "$server" ] || [ "$(cat "/proc/$server/cgroup" 2>/dev/null)" != "$self_cg" ]; then
    echo "repose-tmux-session: session $slug is on a tmux server started outside this unit; leaving it" >&2
    exit 3
  fi
fi
# The server copied this unit's PATH (NixOS gives every unit its
# own). What runs with the server's environment (run-shell, #()
# jobs, a window opened from inside tmux with a command) gets the
# login PATH instead, with every user bin dir (DECISIONS I-227).
# repose-login-path reads it without letting the user's profile
# print into it or replace the shell (DECISIONS I-563).
login_path=$(repose-login-path || true)
if [ -n "$login_path" ]; then
  tmux set-environment -g PATH "$login_path"
fi
# Every window and agent starts with the project's zone; the CLI
# moves it (and /etc/repose/env) when the laptop's changes (I-198).
tz=$(sed -n 's/^TZ=//p' /etc/repose/env 2>/dev/null | tail -n 1 || true)
if [ -n "$tz" ]; then
  tmux set-environment -g TZ "$tz"
fi
# The agents' windows come back under the same names, each agent on
# its conversation (DECISIONS I-636, I-646); a window whose agent
# had already exited comes back as a login shell (I-757). Only in
# a session this run created, and only from a record of an earlier
# boot:
#   1. agent-windows, written at a stop, wins;
#   2. agent-windows.live, the minute record of an earlier boot,
#      with no stop marker for that boot: the machine ended without
#      a stop (a host crash or restart);
#   3. the same with a stop marker: the stop's save was cut short or
#      the machine was killed after it began; the windows reopen as
#      in 2;
#   4. a minute record of this boot: tmux exited and the unit
#      started it again, which reopens nothing (I-551).
# A record that names another project (`#project <id>`) was copied
# by a fork or a snapshot restore into a new project, and reopens
# nothing there. The record is renamed before it is read, so a
# server that exits later in the boot starts with `shell` alone. The
# windows reopened become this boot's minute record at once, so a
# second crash before the timer's first run reopens them again. The
# lock keeps the minute save from writing while this runs
# (repose-tmux-save).
if [ -n "$created" ]; then
  dot="$HOME/.repose"
  exec 9>>"$dot/agent-windows.lock"
  flock -w 10 9 || true
  saved="$dot/agent-windows"
  live="$saved.live"
  boot=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)
  project_id=$(jq -r '.project_id // empty' "$project" 2>/dev/null || true)
  from=""
  if [ -s "$saved" ] && mv -f "$saved" "$saved.restoring"; then
    from=stop
    rm -f "$live"
  elif [ -s "$live" ]; then
    live_boot=$(sed -n '1s/^#boot \([^ ]*\).*/\1/p' "$live")
    if [ -n "$live_boot" ] && [ "$live_boot" != "$boot" ] && mv -f "$live" "$saved.restoring"; then
      stopped=$(cat "$dot/stopped" 2>/dev/null || true)
      if [ "$stopped" = "$live_boot" ]; then
        from=stop-unsaved
      else
        from=minute
      fi
    fi
  fi
  if [ -n "$from" ]; then
    rec_project=$(sed -n 's/^#project //p; s/^#boot [^ ]* //p' "$saved.restoring" | head -n 1)
    if [ -n "$rec_project" ] && [ -n "$project_id" ] && [ "$rec_project" != "$project_id" ]; then
      echo "repose-tmux-session: the $from record belongs to another project (a copy); reopening nothing" >&2
      from=""
      rm -f "$saved.restoring"
    fi
  fi
  if [ -n "$from" ]; then
    echo "repose-tmux-session: reopening agent windows from the $from record" >&2
    tmux_bin=$(command -v tmux)
    window_path=${login_path:-/run/current-system/sw/bin:$PATH}
    seen=" "
    us=$(printf '\037')
    reopened=""
    # The stop record has 4 fields, 5 on a row whose agent had
    # exited; the minute record always has 5 (the window's state),
    # after a `#boot` line. `#` lines are headers. Of the state
    # only `exited` is read here (I-757).
    while IFS="$us" read -r name agent cwd sid state; do
      case "$name" in "#"*) continue ;; esac
      [ -n "$name" ] && [ -d "$cwd" ] || continue
      case "$sid" in *[!A-Za-z0-9_-]*) sid="" ;; esac
      exited=""
      if [ "$state" = exited ]; then
        exited=1
      fi
      if [ -z "$sid" ] && [ -z "$exited" ]; then
        # Without its own id an agent continues the folder's newest
        # conversation; a second such window there would continue
        # the same one, so it is not reopened. An exited row resumes
        # nothing, so it neither takes that key nor loses to it: a
        # live window in the folder still opens (DECISIONS I-757).
        key="$agent:$cwd"
        case "$seen" in *" $key "*) continue ;; esac
        seen="$seen$key "
      fi
      case "$agent" in
        claude) if [ -n "$sid" ]; then cmd="claude --resume $sid"; else cmd="claude --continue"; fi ;;
        codex) if [ -n "$sid" ]; then cmd="codex resume $sid"; else cmd="codex resume --last"; fi ;;
        opencode) cmd="opencode --continue" ;;
        pi) cmd="pi --continue" ;;
        gemini) cmd="gemini --resume latest" ;;
        *) continue ;;
      esac
      if [ -n "$exited" ]; then
        # The agent had already exited when the record was written
        # (the save's `exited`, DECISIONS I-757): nothing to
        # resume, and the window is the user's all the same, so it
        # opens under its name in its folder with the login shell
        # it held, under one line in the shape the refusal below
        # prints. Dropping it instead lost the window with no line
        # anywhere, and `repose ps` and `repose attach -w` could
        # not find it.
        wrapped="echo \"$agent was no longer running when this window was last saved.\"; exec bash -l"
      else
        # The window closes when the agent exits, as one `repose run`
        # opened does, except when the agent refuses to resume (a
        # conversation the crash cut mid-line, one that is gone): it
        # exits non-zero within seconds, and the window keeps a login
        # shell under a line that says so instead of vanishing. Ctrl-C
        # (130) and a TERM (143) are the user's, not a refusal.
        # `set -m` gives the agent its own process group, the
        # terminal's foreground one, so tmux names the agent as the
        # pane's command, which the save reads. It also makes a
        # Ctrl-Z (the agent's own suspend, or the terminal's) stop the
        # job and return 147 to 150 here: the job is put back in the
        # foreground at once, so the window and the agent stay. A
        # function, not a loop: bash leaves a loop whose foreground
        # job stops, so a second Ctrl-Z would end it. `fg`'s stderr
        # stays on the terminal, or it cannot hand the terminal over.
        wrapped="set -m; s=\$SECONDS; r() { if [ \$rc -ge 147 ] && [ \$rc -le 150 ]; then fg >/dev/null; rc=\$?; r; fi; }; $cmd; rc=\$?; r; set +m; if [ \$rc -ne 0 ] && [ \$rc -ne 130 ] && [ \$rc -ne 143 ] && [ \$((SECONDS - s)) -lt 15 ]; then echo \"$agent could not continue its conversation (exit \$rc).\"; exec bash -l; fi; exit \$rc"
      fi
      # A client that is not attached gives the new window its own
      # PATH, not the server's: this unit's PATH has no agent on it
      # (the restored window exited 127, I-640). The login PATH it is.
      if PATH="$window_path" "$tmux_bin" new-window -d -t "=$slug:" -n "$name" -c "$cwd" "$wrapped"; then
        # The exited marker is carried over: a crash before the
        # timer's first run reopens that window as a shell again,
        # not as a resume. Every other row's 5th field is empty.
        reopened+=$(printf '%s\037%s\037%s\037%s\037%s' "$name" "$agent" "$cwd" "$sid" "${exited:+exited}")$'\n'
      fi
    done < "$saved.restoring"
    if [ -n "$boot" ]; then
      body="#boot $boot${project_id:+ $project_id}"$'\n'"$reopened"
      tmp=$(mktemp "$live.XXXXXX")
      if printf '%s' "$body" > "$tmp" && sync "$tmp" && mv -f "$tmp" "$live"; then
        sync "$dot" || true
      else
        rm -f "$tmp"
      fi
    fi
    rm -f "$saved.restoring"
  fi
  flock -u 9 || true
  exec 9>&-
fi
# The Remote Control window, where the laptop's config.toml turned
# it on (DECISIONS I-1132, I-1136). It exits 0 on every path and
# opens nothing unless every condition holds, so the session is
# never held up by it.
repose-remote-control || true
