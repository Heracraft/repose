#!/usr/bin/env bash
# Ported from nix/guest/base for the erofs guest (DECISIONS I-1466).
set -o errexit
set -o nounset
set -o pipefail

if [ -s /run/repose/desktop/vnc-password ] && [ -s /run/repose/desktop/vnc-passwd ]; then
  exit 0
fi
pw=$(head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 8)
umask 077
printf '%s\n' "$pw" > /run/repose/desktop/vnc-password
printf '%s\n' "$pw" | vncpasswd -f > /run/repose/desktop/vnc-passwd
