      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "id": 3
    },
    {
      "type": "gauge",
      "title": "Seat fill",
      "description": "Seats sold, of the seats the ready hosts deliver. The fleet pays for every seat a host delivers around the clock and earns only on the sold ones, so this is the margin number: ladder C clears an AX162-2's $992.10 at 22 of its 30 Solo seats, which is 75% (PRICING.md 'The cost floor'). On Azure no fill clears the host and the credit pays the difference.",
      "datasource": {
        "type": "prometheus",
        "uid": "repose-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "repose-prometheus"
          },
          "editorMode": "code",
          "expr": "max(repose_api_seats_held) / max(repose_api_seats_total)",
          "legendFormat": "fill",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.75
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "gridPos": {
        "h": 6,
        "w": 7,
        "x": 10,
        "y": 1
      },
      "id": 4
    },
    {
      "type": "gauge",
      "title": "Seat use",
      "description": "The memory actually running, over the memory the sold seats may run (a seat is 8 GB, I-290). A subscription holds its seats whether its machines run or not, so the gap between this and Seat fill is capacity that is bought, paid for and idle. It is not a number to drive to 100%: a stopped project is a user within their plan. It is the number that says whether the plan shape sells memory people use.",
      "datasource": {
        "type": "prometheus",
        "uid": "repose-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "repose-prometheus"
          },
          "editorMode": "code",
          "expr": "(((4 * sum(repose_host_guests{state=\"running\",class=\"small\"})) or vector(0)) + ((8 * sum(repose_host_guests{state=\"running\",class=\"large\"})) or vector(0)) + ((16 * sum(repose_host_guests{state=\"running\",class=\"xl\"})) or vector(0))) / (8 * max(repose_api_seats_held))",
          "legendFormat": "use",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "gridPos": {
        "h": 6,
        "w": 7,
        "x": 17,
        "y": 1
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Seats delivered, sold and running",
      "description": "Three lines in seats. Delivered is what the ready, undrained hosts can serve, each the smaller of its 8 GB blocks and what its cores allow (I-739, I-784); sold is held by live subscriptions and unexpired invitations; running is the memory of running guests, in 8 GB units. Delivered falling is a host drained or lost. Sold meeting delivered is the waitlist starting.",
      "datasource": {
        "type": "prometheus",
        "uid": "repose-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "repose-prometheus"
          },
          "editorMode": "code",
          "expr": "max(repose_api_seats_total)",
          "legendFormat": "delivered",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "repose-prometheus"
          },
          "editorMode": "code",
          "expr": "max(repose_api_seats_held)",
          "legendFormat": "sold",
          "range": true,
          "instant": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "repose-prometheus"
          },
          "editorMode": "code",
          "expr": "(((4 * sum(repose_host_guests{state=\"running\",class=\"small\"})) or vector(0)) + ((8 * sum(repose_host_guests{state=\"running\",class=\"large\"})) or vector(0)) + ((16 * sum(repose_host_guests{state=\"running\",class=\"xl\"})) or vector(0))) / 8",
          "legendFormat": "running",
          "range": true,
          "instant": false,
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
