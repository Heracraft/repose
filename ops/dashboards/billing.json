        "type": "prometheus",
        "uid": "repose-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "repose-prometheus"
          },
          "editorMode": "code",
          "expr": "max(repose_api_mrr_cents{status=\"trialing\"}) / 100",
          "legendFormat": "trialing",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "currencyUSD",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
