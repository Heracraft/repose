{
  "uid": "repose-billing",
  "title": "repose / Billing",
  "description": "Plans through Polar (DECISIONS I-289, I-604): the subscription mix, the webhook, the gate's refusals, the egress overage line, and the hours and egress usage_hours records. Polar holds the money; usage_hours holds what was used.",
  "tags": [
    "repose"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-2d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "The money",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "MRR",
      "description": "The plan revenue a month of the subscriptions that are being charged, at the list price each one is on and with the founding discount taken off while it runs. Polar is the ledger; this is the api's reading of the subscriptions table. max by (status), not sum: two api replicas publish the gauge and a scrape lands on one of them.",
      "datasource": {
        "type": "prometheus",
        "uid": "repose-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "repose-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(max by (status) (repose_api_mrr_cents{status=~\"active|past_due\"})) / 100",
          "legendFormat": "mrr",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "currencyUSD",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "id": 2
    },
    {
      "type": "stat",
