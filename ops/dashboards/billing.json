        "textMode": "auto"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Subscription webhooks by plan and status",
      "description": "Every subscription.* event applied, by the plan it names and its status. A rising past_due series is the dunning job's next three days.",
      "datasource": {
        "type": "prometheus",
        "uid": "repose-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "repose-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (plan, status) (increase(repose_api_billing_subscriptions_total[1h]))",
          "legendFormat": "{{plan}} {{status}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
