      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Signals: sessions, tmux clients, containers",
      "description": "The signals DESIGN \u00a715 records from day one so that an idle policy can be designed from data rather than guessed.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "repose-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "repose-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select ts as time, ssh_sessions as \"ssh sessions\", tmux_clients as \"tmux clients\", docker_containers as \"docker containers\" from meter_samples where project_id = '$project_id'::uuid and $__timeFilter(ts) order by ts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 5
    },
    {
      "type": "state-timeline",
      "title": "Agent state",
      "description": "working, idle, needs_input or unknown, per agent process, from guestd's tmux window state. This is the series an idle policy would be built on.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "repose-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "repose-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select ts as time, coalesce(a->>'agent', 'none') || ': ' || coalesce(a->>'state', 'unknown') as agent from meter_samples left join lateral jsonb_array_elements(agents) a on true where project_id = '$project_id'::uuid and $__timeFilter(ts) order by ts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "mergeValues": true,
        "showValue": "auto"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6
    },
    {
      "type": "state-timeline",
      "title": "Guest state and guestd",
      "description": "The guest's own state, with the gaps where guestd was unreachable. Samples continue during those gaps; the signals inside them do not. A null guestd_ok is a sample from before the column existed, which is unknown rather than lost (DECISIONS I-54).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "repose-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "repose-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select ts as time, state || (case when guestd_ok is false then ' (guestd lost)' when guestd_ok is null then ' (guestd unknown)' else '' end) as state from meter_samples where project_id = '$project_id'::uuid and $__timeFilter(ts) order by ts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "mergeValues": true,
        "showValue": "auto"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 7
    },
    {
      "type": "table",
      "title": "Top processes in the window",
      "description": "Process names only: no arguments, no environment, no paths (DECISIONS R5-3, and the privacy policy in the same words).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "repose-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "repose-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select comm, sum(cpu_ns) / 1e9 as cpu_seconds, max(rss) as max_rss from proc_samples where project_id = '$project_id'::uuid and $__timeFilter(ts) group by comm order by cpu_seconds desc limit 20",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "gridPos": {
        "h": 8,
