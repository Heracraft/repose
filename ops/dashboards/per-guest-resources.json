              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Network",
      "description": "Bytes a second, from the per-guest nftables counters. Egress is what is billed past 500 GB a month.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "repose-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "repose-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select ts as time, net_tx / 60.0 as tx, net_rx / 60.0 as rx from meter_samples where project_id = '$project_id'::uuid and $__timeFilter(ts) order by ts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
