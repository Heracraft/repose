{
  "uid": "repose-per-guest",
  "title": "repose / Per-guest resources",
  "description": "One project over time, from meter_samples in Postgres. Prometheus carries no per-project series on purpose (\u00a75); this is where a support question is answered.",
  "tags": [
    "repose"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project_id",
        "label": "project",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "repose-postgres"
        },
        "query": "select p.slug || ' (' || u.handle || ')' as __text, p.id::text as __value from projects p join users u on u.id = p.user_id where p.destroyed_at is null order by 1",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "allValue": null,
        "regex": "",
        "current": {},
        "options": [],
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU busy fraction",
      "description": "cpu_ns is the delta since the previous sample, 60 seconds apart, so this is cores busy. A small guest has 1 vCPU, a large 2, an xl 4 (DECISIONS I-784).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "repose-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "repose-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select ts as time, cpu_ns / 60e9 as cpu from meter_samples where project_id = '$project_id'::uuid and $__timeFilter(ts) order by ts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Memory RSS",
      "description": "Resident memory of the guest. It cannot exceed the class (4, 8 or 16 GB) because memory is never oversubscribed.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "repose-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "repose-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select ts as time, mem_rss as rss from meter_samples where project_id = '$project_id'::uuid and $__timeFilter(ts) order by ts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
