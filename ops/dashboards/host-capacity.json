{
  "uid": "repose-host-capacity",
  "title": "repose / Host capacity",
  "description": "Whether the fleet can take another guest, and whether each host is healthy. Capacity is added by hand at 80 percent reserved memory (DECISIONS R3-5).",
  "tags": [
    "repose"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host_id",
        "label": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "repose-prometheus"
        },
        "query": {
          "query": "label_values(repose_host_mem_free_bytes, host_id)",
          "refId": "hosts"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "regex": "",
        "current": {},
        "options": [],
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Reserved memory",
      "description": "The HostMemory80 expression. Memory is never oversubscribed, so this is the capacity figure.",
      "datasource": {
        "type": "prometheus",
        "uid": "repose-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "repose-prometheus"
          },
          "editorMode": "code",
          "expr": "repose_host_mem_reserved_bytes{host_id=~\"$host_id\"} / (repose_host_mem_reserved_bytes{host_id=~\"$host_id\"} + repose_host_mem_free_bytes{host_id=~\"$host_id\"})",
          "legendFormat": "{{host_id}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Stream connected",
      "description": "1 while hostd holds its Session stream to the api. A zero here and a HostUnreachable alert are the same incident.",
      "datasource": {
        "type": "prometheus",
        "uid": "repose-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "repose-prometheus"
          },
          "editorMode": "code",
          "expr": "min by (host_id) (repose_host_stream_connected{host_id=~\"$host_id\"})",
          "legendFormat": "{{host_id}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Builds running",
      "description": "At most two per host (DECISIONS R5-4). Two for 45 minutes with nothing finishing is BuildQueueStuck.",
      "datasource": {
        "type": "prometheus",
        "uid": "repose-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "repose-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (host_id) (repose_host_builds_running{host_id=~\"$host_id\"})",
          "legendFormat": "{{host_id}}",
          "range": false,
          "instant": true,
          "refId": "A"
