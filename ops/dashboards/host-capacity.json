    {
      "type": "timeseries",
      "title": "Guest CPU seconds by class",
      "description": "Busy guest vCPUs, by size class. Placement commits at most 1.5 guest vCPUs per physical core (DECISIONS I-734); past 1 busy vCPU per core, typing is laggy in every guest on the host and HostCPUSaturated warns. Divide by repose_host_cpu_cores, not by the vendor's vCPU count.",
      "datasource": {
        "type": "prometheus",
        "uid": "repose-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "repose-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (class) (rate(repose_host_guest_cpu_seconds_total{host_id=~\"$host_id\"}[5m]))",
