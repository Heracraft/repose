# A package whose changed files are all _test.go reaches no binary: go does
# not compile a test file into one. internal/edge is in cmd/gateway's deps,
# so a change to its test alone is charged an edge switch -- the owner's,
# and on a gateway that is byte-identical (the cpu-weight lane, 2026-10-15).
t_needs_ignores_a_test_only_change() {
  local wt; wt=$(branch woker test-only)
  echo '// another case' >> "$wt/internal/edge/edge_test.go"
  commit "$wt" "a test"
  assert_eq "a _test.go-only change" "$(needs_line "$(q "$wt" add)")" "none"
}

t_needs_docs_only() {
  local wt; wt=$(branch woker docs-only)
  echo 'A note.' >> "$wt/docs/DECISIONS.md"
  commit "$wt" "docs"
  assert_eq "a docs-only branch" "$(needs_line "$(q "$wt" add)")" "none"
}

# P4. The checks region of nix/flake.nix is evaluated by a gate and
# installed by nothing. A change inside it reaches no machine, and the
# conductor who reads "base,edge,host" switches two of them for it
# (dev-tool-guards, 6950361a: a comment and an awk script in
# checks.guest-closure-size).
t_needs_flake_checks_only() {
  local wt; wt=$(branch woker flake-checks)
  python3 - "$wt/nix/flake.nix" <<'PY'
import sys
p = sys.argv[1]
s = open(p).read()
s = s.replace('echo "guest system closure"', 'echo "guest system closure"\n          # a comment inside the check')
open(p, "w").write(s)
PY
  commit "$wt" "the closure gate prints the paths"
  assert_eq "a change only inside the flake's checks" "$(needs_line "$(q "$wt" add)")" "none"
}

# P5. `needs` and the commit count are read against refs/heads/main, which
# on woker-1 was 132 commits behind origin/main on 2026-10-15. This branch
# ships one CLI commit; against a stale main it claims everything that
# landed meanwhile.
t_needs_against_stale_local_main() {
  # origin moves ahead with a host change; woker's refs/heads/main does not.
  local other; other=$(branch kanali host-change)
  echo '# a host module' >> "$other/nix/hosts/default.nix"
  commit "$other" "hosts"
  git -C "$other" push -q origin "HEAD:refs/heads/main"
  git -C "$other" push -q origin "HEAD:refs/heads/integrated"
  git -C "$root/woker" fetch -q origin

  local wt; wt=$(branch woker late-cli refs/remotes/origin/integrated)
  echo 'const More = 1' >> "$wt/internal/clipkg/clipkg.go"
  commit "$wt" "cli"
  local o; o=$(q "$wt" add)
  assert_eq "ships as" "$(needs_line "$o")" "cli" || return 1
  assert_has "the commit count" "$o" "(1 commits" || return 1
}

# -------------------------------------------------------------------- ids

t_id_sees_local_branch() {
  local wt; wt=$(branch woker took-id)
  printf '\n**I-200. Taken on a branch.** (fixture) Text.\n' >> "$wt/docs/DECISIONS.md"
  commit "$wt" "I-200"
  local wt2; wt2=$(branch woker other)
  assert_eq "the next id after I-200 on another branch" "$(q "$wt2" id)" "I-201"
}

t_id_sees_range_header() {
  # the seed has **I-101..I-103, so 104 is next
  local wt; wt=$(branch woker ranged)
  assert_eq "both ends of a range header count" "$(q "$wt" id)" "I-104"
}

t_id_sees_remote_tracking() {
  local other; other=$(branch kanali remote-id)
  printf '\n**I-300. Integrated elsewhere.** (fixture) Text.\n' >> "$other/docs/DECISIONS.md"
  commit "$other" "I-300"
  git -C "$other" push -q origin "HEAD:refs/heads/integrated"
  git -C "$root/woker" fetch -q origin
  local wt; wt=$(branch woker after-fetch)
  assert_eq "an id only on origin/integrated" "$(q "$wt" id)" "I-301"
}

t_id_sees_uncommitted_worktree() {
  local wt; wt=$(branch woker uncommitted)
  printf '\n**I-400. Written, not committed.** (fixture) Text.\n' >> "$wt/docs/DECISIONS.md"
  local wt2; wt2=$(branch woker asker)
  assert_eq "an id in a working copy" "$(q "$wt2" id)" "I-401"
}

t_id_hands_out_several() {
  local wt; wt=$(branch woker several)
  assert_eq "three ids" "$(q "$wt" id 3 | paste -sd' ')" "I-104 I-105 I-106"
}

t_id_refuses_used_number() {
  # a reservation below an entry id must not be handed out again: plant a
  # reservation for I-104 and an entry for I-105, so arithmetic that
  # trusts the reservations alone would offer I-105.
  local wt; wt=$(branch woker clash)
  printf '\n**I-105. Already an entry.** (fixture) Text.\n' >> "$wt/docs/DECISIONS.md"
  commit "$wt" "I-105"
  local s; s=$(state_of woker)/release-queue
  echo "I-104 someone 2026-10-15" >> "$s/ids"
  assert_eq "the next id skips the entry" "$(q "$wt" id)" "I-106"
}

# P1. The reservations file lives in each machine's own git dir, so an id
# reserved on kanali is invisible on woker-1 until it reaches a shared
# ref. I-718, I-719, I-732 and I-740 were each handed out twice this way.
t_id_sees_other_machine_reservation() {
  local there; there=$(branch kanali reserving)
  local got_there; got_there=$(q "$there" id)
  assert_eq "kanali reserves" "$got_there" "I-104" || return 1
  local here; here=$(branch woker asking)
  local got_here; got_here=$(q "$here" id)
  [ "$got_here" != "$got_there" ] || { note "woker handed out $got_here, which kanali already holds"; return 1; }
  assert_eq "woker's next id" "$got_here" "I-105"
}

# ------------------------------------------------------------------- add

t_add_refuses_dirty_tree() {
  local wt; wt=$(branch woker dirty)
  echo 'const More = 1' >> "$wt/internal/shared/shared.go"
  commit "$wt" "shared"
  echo 'const Dirty = 1' >> "$wt/internal/shared/shared.go"
  local o; o=$(q "$wt" add)
  assert_has "a dirty tree is refused" "$o" "uncommitted changes"
}

t_add_refuses_main() {
  local o; o=$(q "$root/woker" add)
  assert_has "main is refused" "$o" "work in a worktree"
}

t_add_refuses_no_commits() {
  local wt; wt=$(branch woker empty)
  local o; o=$(q "$wt" add)
  assert_has "a branch with nothing new is refused" "$o" "no commits that main lacks"
}

t_add_runs_cli_guards() {
  local wt; wt=$(branch woker loud-cli)
  echo 'const More = 1' >> "$wt/internal/clipkg/clipkg.go"
  commit "$wt" "cli"
  local o; o=$(cd "$wt" && REPOSE_FIXTURE_CLI_FAIL=1 PATH="$root/bin:$PATH" ops/dev/release-queue add 2>&1)
