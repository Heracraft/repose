# P10 (not in the brief; found by the cpu-weight lane, 2026-10-15). The
# entry file is flat key=value, written as a block of `echo "key=$value"`.
# A --note or --live value with a newline in it becomes one key=value line
# plus orphan lines, and `add` prints a success line over it.
t_add_rejects_a_multiline_note() {
  local wt; wt=$(branch woker multiline-note)
  echo 'const More = 1' >> "$wt/internal/shared/shared.go"; commit "$wt" "shared"
  local note; note=$'paragraph one
paragraph two
paragraph three'
  q "$wt" add --note "$note" >/dev/null 2>&1
  local s f; s=$(state_of woker)/release-queue; f=$s/entries/multiline-note
  [ -f "$f" ] || { note "no entry was written"; return 1; }
  local orphans; orphans=$(grep -cv '^[a-z]*=' "$f")
  assert_eq "orphan lines in the entry" "$orphans" "0" || return 1
  # and the note must survive, flattened rather than truncated
  assert_has "the whole note is readable" "$(field_of "$f" note)" "paragraph three"
}

# Worse than losing the paragraphs: field() takes the FIRST line matching a
# key, and note= is written before state=, sha= and needs=, so a note line
# that looks like a key silently wins over the real one. An entry whose
# state reads released is dropped from `ls` entirely.
t_add_note_cannot_forge_a_field() {
  local wt; wt=$(branch woker forged)
  echo 'const More = 1' >> "$wt/internal/shared/shared.go"; commit "$wt" "shared"
  local note; note=$'why this branch exists
state=released
and the rest of the reason'
  q "$wt" add --note "$note" >/dev/null 2>&1
  local s f; s=$(state_of woker)/release-queue; f=$s/entries/forged
  [ -f "$f" ] || { note "no entry was written"; return 1; }
  assert_eq "the entry's state" "$(field_of "$f" state)" "queued" || return 1
  assert_has "and it is still in the queue" "$(q "$root/woker" ls)" "forged"
}

# P10, second half (the cpu-weight lane's sweep, 2026-10-15). `cmd_add`
# writes "$f.new" and moves it into place, and `setfield` writes
# "$f.XXXX"; every reader globs entries/*. So an add or a setfield killed
# between the write and the mv leaves a file that is a complete entry, and
# the branch is then queued twice -- `ls` lists it twice and `cut` merges
# it twice, the stray at whatever sha it held.
t_stray_temp_entry_is_not_a_branch() {
  local wt; wt=$(branch woker interrupted)
  echo 'const A = 1' >> "$wt/internal/shared/shared.go"; commit "$wt" "a"
  q "$wt" add >/dev/null
  local s; s=$(state_of woker)/release-queue
  local old_sha; old_sha=$(field_of "$s/entries/interrupted" sha)
  # The branch moves on, and the second `add` is killed between its write
  # and its mv: entries/interrupted.new is left holding the NEW commit while
  # entries/interrupted still holds the old one. A later add would clean the
  # stray up as a side effect of its own write, so the exposure is a cut
  # that comes first -- which is what the lane is told to let happen.
  echo 'const B = 1' >> "$wt/internal/shared/shared.go"; commit "$wt" "b"
  sed "s/^sha=.*/sha=$(git -C "$wt" rev-parse HEAD)/" "$s/entries/interrupted" \
    > "$s/entries/interrupted.new"
  local listed; listed=$(q "$root/woker" ls | grep -c 'interrupted')
  assert_eq "times the branch is listed" "$listed" "1" || return 1
  local out; out=$(q "$root/woker" cut)
  local merged; merged=$(grep -c 'merged interrupted' <<<"$out")
  assert_eq "times the cut merges it" "$merged" "1" || { note "$out"; return 1; }
  # and at the commit the completed add recorded, not the stray's: the second
  # add never finished, so the queue holds the older commit on purpose and
  # `ls` marks the branch as moved since it was queued.
  assert_has "the cut takes the queued commit" "$out" "${old_sha:0:9}"
}

# P10, third: key() is `tr '/' '%'`, which is not injective. A branch
# named a%b and a branch named a/b encode to the same filename, so the
# second to queue silently overwrites the first's entry -- and `/` is the
# common case here (ws/01-host-nixos, release/r20261015-4). Found while
# checking the cpu-weight lane's sweep, which turned up repose%fider on
# kanali as the encoding working as designed.
t_two_branches_keep_two_entries() {
  local a b; a=$(branch woker 'pair/one'); b=$(branch woker 'pair%one')
  echo 'const A = 1' >> "$a/internal/shared/shared.go"; commit "$a" "a"
  echo 'const B = 1' >> "$b/internal/clipkg/clipkg.go"; commit "$b" "b"
  q "$a" add >/dev/null; sleep 0.01; q "$b" add >/dev/null
  local s; s=$(state_of woker)/release-queue
  local files; files=$(find "$s/entries" -type f | wc -l)
  assert_eq "entry files for two branches" "$files" "2" || return 1
  local out; out=$(q "$root/woker" ls)
  assert_has "the first branch is still queued" "$out" "pair/one" || return 1
  assert_has "and so is the second" "$out" "pair%one"
}

# --------------------------------------------------------------- where is it

# P3. `ls` drops a released entry, so "did this branch ship" has no
# answer from the tool; two agents read the leftover worktree
# ~/kanali-boot-real-addr as unqueued work after it had shipped in
# r20261014-1.
t_where_is_released_branch() {
  local wt; wt=$(branch woker shipped)
  echo 'const More = 1' >> "$wt/internal/shared/shared.go"
  commit "$wt" "shared"
  q "$wt" add >/dev/null
  q "$root/woker" cut >/dev/null
  local rel; rel=$(cut_release woker)
  git -C "$root/woker" merge -q --ff-only "release/$rel"
  q "$root/woker" "done" "$rel" >/dev/null
  git -C "$root/woker" push -q origin main:main
  git -C "$root/woker" fetch -q origin
  local o; o=$(q "$wt" where shipped)
  assert_has "a released branch is named released" "$o" "released" || return 1
  assert_has "and names the release it shipped in" "$o" "$rel"
}

# P2. kanali's queue is the authoritative one and nothing says so: an
# agent on kanali told the conductor its branch was invisible from
# woker-1 and should be fetched, an hour after it was merged.
t_where_is_branch_on_the_other_box() {
  local there; there=$(branch kanali queued-there)
  echo 'const More = 1' >> "$there/internal/shared/shared.go"
  commit "$there" "shared"
  q "$there" add >/dev/null
  git -C "$there" push -q origin "HEAD:refs/heads/queued-there"
  git -C "$root/woker" fetch -q origin
  local o; o=$(q "$root/woker" where queued-there)
  assert_has "woker can say where a branch queued on kanali is" "$o" "queued"
}

# ---------------------------------------------------------------- cut, done

t_cut_merges_in_queue_order() {
  local a b; a=$(branch woker first); b=$(branch woker second)
  echo 'const A = 1' >> "$a/internal/shared/shared.go"; commit "$a" "a"
  echo 'const B = 1' >> "$b/internal/clipkg/clipkg.go"; commit "$b" "b"
  q "$a" add >/dev/null; sleep 0.01; q "$b" add >/dev/null
  local o; o=$(q "$root/woker" cut)
  assert_has "both are merged" "$o" "merged first" || return 1
  assert_has "both are merged" "$o" "merged second" || return 1
  local order; order=$(sed -n 's/.*merged \([a-z]*\) .*/\1/p' <<<"$o" | paste -sd, -)
  assert_eq "queue order" "$order" "first,second"
}

t_cut_regenerates_decisions_index() {
  local a b; a=$(branch woker dec-a); b=$(branch woker dec-b)
  local i
  for i in a b; do
    local wt; wt=$([ $i = a ] && echo "$a" || echo "$b")
    printf '\n**I-%s. Entry %s.** (fixture) Text.\n' "$([ $i = a ] && echo 110 || echo 111)" "$i" >> "$wt/docs/DECISIONS.md"
    ( cd "$wt" && python3 ops/dev/decisions-index.py >/dev/null )
    commit "$wt" "decision $i"
  done
  q "$a" add >/dev/null; sleep 0.01; q "$b" add >/dev/null
  local o; o=$(q "$root/woker" cut)
  assert_has "the index conflict is settled by the generator" "$o" "regenerated"
}

t_done_requires_main_to_hold_it() {
  local wt; wt=$(branch woker not-yet)
  echo 'const More = 1' >> "$wt/internal/shared/shared.go"; commit "$wt" "shared"
  q "$wt" add >/dev/null
  q "$root/woker" cut >/dev/null
  local rel; rel=$(cut_release woker)
  local o; o=$(q "$root/woker" "done" "$rel")
  assert_has "done refuses before main holds it" "$o" "does not hold"
}

t_abandon_requeues() {
  local wt; wt=$(branch woker goes-back)
  echo 'const More = 1' >> "$wt/internal/shared/shared.go"; commit "$wt" "shared"
  q "$wt" add >/dev/null
  q "$root/woker" cut >/dev/null
  local rel; rel=$(cut_release woker)
  q "$root/woker" abandon "$rel" >/dev/null
  assert_has "the branch is queued again" "$(q "$root/woker" ls)" "queued     goes-back"
}

# ------------------------------------------------------- the script's own age

# P6. 44 of the 52 worktrees on woker-1 carried an older
# ops/dev/release-queue on 2026-10-15, the main checkout among them, and
# running one said nothing.
t_stale_script_warns() {
  local wt; wt=$(branch woker old-copy)
  # an older copy, as a worktree cut from an older main has
  sed -i '1a # an older generation of this script' "$wt/ops/dev/release-queue"
  git -C "$wt" checkout -q -- ops/dev/release-queue 2>/dev/null || true
  sed -i '1a # an older generation of this script' "$wt/ops/dev/release-queue"
  local o; o=$(q "$wt" ls)
  assert_has "an older copy says so" "$o" "origin/integrated"
}

# A branch that is itself changing the tool is its author, not a stale
# copy, and must not be told to take the script from origin/integrated.
t_author_script_no_warning() {
  local wt; wt=$(branch woker tool-change)
  sed -i '1a # this branch changes the tool' "$wt/ops/dev/release-queue"
  commit "$wt" "the tool"
  local o; o=$(q "$wt" ls)
  assert_not "the author is not warned" "$o" "take the script from"
}

# ------------------------------------------------------------- the live check

# P7. `add --live` stores the text and nothing stores whether it ran or
# what it printed; three releases went out with "NOT DONE: the --live
# checks" in their STATUS line.
t_live_check_is_recorded() {
  local wt; wt=$(branch woker live-recorded)
  echo 'const More = 1' >> "$wt/internal/shared/shared.go"; commit "$wt" "shared"
  q "$wt" add --live "repose start under 12 s" >/dev/null
  local o; o=$(q "$root/woker" live live-recorded --ran "started in 7.4 s on e2e-top")
  assert_has "the result is stored" "$o" "live-recorded" || return 1
  local s; s=$(state_of woker)/release-queue
  assert_has "and read back" "$(cat "$s/entries/live-recorded")" "started in 7.4 s"
}

