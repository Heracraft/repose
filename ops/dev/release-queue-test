  echo 'const More = 1' >> "$wt/internal/clipkg/clipkg.go"
  commit "$wt" "cli"
  local o; o=$(cd "$wt" && REPOSE_FIXTURE_CLI_FAIL=1 PATH="$root/bin:$PATH" ops/dev/release-queue add 2>&1)
