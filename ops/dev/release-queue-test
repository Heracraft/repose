#!/usr/bin/env bash
# Tests for ops/dev/release-queue, against a scratch world instead of this
# repository. `release-queue` reserves decision ids, reads the deploy
# targets out of a diff and merges branches; every one of those was
# verified by running it on the real checkout, which is why six ids were
# taken twice and a comment in a test script asked for two host switches
# (docs/research/queue-revamp.md). None of it is testable in place: the
# state lives in the common git dir of a checkout with 50 worktrees, and
# `cut` makes branches and worktrees.
#
#   ops/dev/release-queue-test            run every test
#   ops/dev/release-queue-test needs      run the tests whose name matches
#   ops/dev/release-queue-test -k         keep the scratch world and print it
#
# The scratch world is three clones of a synthetic repository that has the
# shape release-queue reads: the seven cmd/ binaries with internal
# packages between them, apps/web, nix/ split the way the real one is,
# infra/, docs/DECISIONS.md, and the `ops/dev/release-queue` under test
# copied in. `origin.git` is GitHub, `woker` is the conductor's box and
# `kanali` the agents' box, so a test can say what one machine sees of
# the other's reservations.
#
# A test asserts the behaviour its name asks for. KNOWN_BAD below names
# the tests that fail until their fix lands; the suite exits 0 when
# exactly those fail, and 1 when any other fails or when a known-bad one
# starts passing, which means its line here is stale.
set -uo pipefail

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
keep=0
[ "${1:-}" != -k ] || { keep=1; shift; }
filter=${1:-}

# ---------------------------------------------------------------- known bad

# Each line: the test name, the problem it belongs to, one line of why.
KNOWN_BAD="
id_sees_other_machine_reservation  P1 the reservations file never leaves the machine
where_is_released_branch           P3 no command answers 'did this branch ship'
where_is_branch_on_the_other_box   P2 the queue state is per machine
stale_script_warns                 P6 a worktree's old copy says nothing
live_check_is_recorded             P7 nothing stores whether the check ran
"
# KNOWN_BAD lines are indented in the heredoc above; strip the indent once.
# shellcheck disable=SC2001  # a per-line strip, which ${v//x/y} cannot do
known_bad_lines=$(sed 's/^[[:space:]]*//' <<<"$KNOWN_BAD")
known_bad() { grep -qE "^$1 " <<<"$known_bad_lines"; }
known_bad_why() { sed -n "s/^$1  *//p" <<<"$known_bad_lines"; }

# -------------------------------------------------------------------- plumbing

pass=0; fail=0; xfail=0; xpass=0
out=$(mktemp -d); trap 'cleanup' EXIT
cleanup() { [ $keep = 1 ] && { echo "scratch world kept: $root"; return; }; rm -rf "$out" "${root:-/nonexistent}"; }

ok()   { printf '  ok      %s\n' "$*"; }
bad()  { printf '  FAIL    %s\n' "$*"; }
note() { printf '          %s\n' "$*"; }

# assert_eq <what> <got> <want>
assert_eq() {
  if [ "$2" = "$3" ]; then return 0; fi
  note "$1: got '$2', want '$3'"; return 1
}
# assert_has <what> <haystack> <needle>
assert_has() {
  if grep -qF -- "$3" <<<"$2"; then return 0; fi
  note "$1: '$3' is not in: $(head -c 300 <<<"$2")"; return 1
}
# assert_not <what> <haystack> <needle>
assert_not() {
  if grep -qF -- "$3" <<<"$2"; then note "$1: '$3' is in: $(head -c 300 <<<"$2")"; return 1; fi
  return 0
}

run_test() { # name
  local name=$1 rc
  [ -z "$filter" ] || [[ $name == *$filter* ]] || return 0
  world >/dev/null 2>&1   # every test gets a fresh world
  "t_$name" >"$out/$name.log" 2>&1; rc=$?
  if [ $rc = 0 ]; then
    if known_bad "$name"; then
      bad "$name (known bad, but it passed: remove its KNOWN_BAD line)"; xpass=$((xpass + 1))
    else ok "$name"; pass=$((pass + 1)); fi
  else
    if known_bad "$name"; then
      printf '  known   %s  (%s)\n' "$name" "$(known_bad_why "$name")"
      xfail=$((xfail + 1))
    else bad "$name"; sed 's/^/          /' "$out/$name.log"; fail=$((fail + 1)); fi
  fi
}

# q runs release-queue in a worktree and prints its output and exit code.
q() { # dir args...
  local d=$1; shift
  ( cd "$d" && PATH="$root/bin:$PATH" REPOSE_QUEUE_EQUIV="$root/bin/equiv-stub" \
      ops/dev/release-queue "$@" 2>&1 )
}

# ------------------------------------------------------------------ the world

# world builds origin.git, woker and kanali from scratch. Keep it cheap:
# every test calls it.
world() {
  rm -rf "${root:-/nonexistent}"
  root=$(mktemp -d "${TMPDIR:-/tmp}/rq-fixture.XXXXXX")
  mkdir -p "$root/bin"
  # A pnpm that answers for the web copy guards, so a `web` branch can be
  # queued without node_modules and a real install.
  cat > "$root/bin/pnpm" <<'EOF'
#!/usr/bin/env bash
# fixture stub: exits 0, or 1 when the tree plants REPOSE_FIXTURE_PNPM_FAIL
[ -z "${REPOSE_FIXTURE_PNPM_FAIL:-}" ] || exit 1
exit 0
EOF
  chmod +x "$root/bin/pnpm"
  # The comparison release-queue runs for base/host/edge. The scratch
  # repository is not an evaluable flake, so this stands in for
  # ops/dev/closure-equiv.py. It answers "the system really changes" by
  # default, which is the conservative answer and the one that leaves the
  # path-derived targets alone; a test that wants the narrowing exercised
  # sets REPOSE_FIXTURE_EQUIV_SAME. The comparison itself is checked
  # against this repository's own revisions, not here.
  cat > "$root/bin/equiv-stub" <<'EOF'
#!/usr/bin/env bash
if [ -n "${REPOSE_FIXTURE_EQUIV_SAME:-}" ]; then
  echo "VERDICT: the same system; only the version stamp differs"; exit 0
fi
echo "VERDICT: the system really changes"; exit 1
EOF
  chmod +x "$root/bin/equiv-stub"

  local src=$root/src
  mkdir -p "$src"
  ( cd "$src" && seed_repo )

  git init -q --bare "$root/origin.git"
  # the bare repo's HEAD decides what a clone checks out
  git -C "$root/origin.git" symbolic-ref HEAD refs/heads/main
  git -C "$src" remote add origin "$root/origin.git"
  git -C "$src" push -q origin main:main
  git -C "$src" push -q origin main:integrated

  git clone -q "$root/origin.git" "$root/woker"
  git clone -q "$root/origin.git" "$root/kanali"
  local c
  for c in woker kanali; do
    git -C "$root/$c" config user.email fixture@example.com
    git -C "$root/$c" config user.name fixture
    git -C "$root/$c" config commit.gpgsign false
  done
}

# seed_repo writes the synthetic repository in the current directory and
# commits it as `main`. Its shape, not its content, is what matters: the
# seven binaries and the packages between them, so `go list -deps` has
# something to resolve, and the nix/ split the real flake has.
seed_repo() {
  git init -q -b main .
  git config user.email fixture@example.com
  git config user.name fixture
  git config commit.gpgsign false

  cat > go.mod <<'EOF'
module repose.test

go 1.24
EOF
  local p
  # internal packages, and which binaries import them
  for p in shared clipkg guest edge; do
    mkdir -p "internal/$p"
    printf 'package %s\n\nconst Name = "%s"\n' "$p" "$p" > "internal/$p/$p.go"
  done
  # a test file in a package cmd/gateway imports: changing it alone changes
  # no binary, because go does not compile _test.go into one
  cat > internal/edge/edge_test.go <<'EOF'
package edge

import "testing"

func TestName(t *testing.T) {
	if Name != "edge" {
		t.Fatal(Name)
	}
}
EOF
  # internal/cli holds the trust-the-reader guards release-queue runs for a
  # branch that ships as cli.
  mkdir -p internal/cli
  printf 'package cli\n\nconst Name = "cli"\n' > internal/cli/cli.go
  cat > internal/cli/guards_test.go <<'EOF'
package cli

import (
	"os"
	"testing"
)

// The fixture's stand-ins for the real guards (DECISIONS I-484, I-485).
// A tree that plants REPOSE_FIXTURE_CLI_FAIL fails them, which is how the
// test for `add` refusing such a branch is written.
func TestSuccessOutputNamesNoCommand(t *testing.T) {
	if os.Getenv("REPOSE_FIXTURE_CLI_FAIL") != "" {
		t.Fatal("fixture: the CLI prints help nobody asked for")
	}
}

func TestCLIReassures(t *testing.T) {
	if os.Getenv("REPOSE_FIXTURE_CLI_FAIL") != "" {
		t.Fatal("fixture: the CLI reassures")
	}
}
EOF
  # a non-Go file under a package directory: it ships with the package above it
  mkdir -p internal/api/mail
  printf 'package mail\n\nconst Name = "mail"\n' > internal/api/mail/mail.go
  printf 'Welcome.\n' > internal/api/mail/welcome.txt

  mk_cmd() { # dir import...
    local d=$1; shift
    mkdir -p "cmd/$d"
    { echo 'package main'; echo; echo 'import ('
      for p in "$@"; do echo "	_ \"repose.test/internal/$p\""; done
      echo ')'; echo; echo 'func main() {}'; } > "cmd/$d/main.go"
  }
  mk_cmd api shared api/mail
  mk_cmd repose-admin shared
  mk_cmd repose clipkg
  mk_cmd hostd shared
  mk_cmd guestd guest
  mk_cmd repose-hook guest
  mk_cmd gateway edge

  mkdir -p apps/web/src apps/web/node_modules
  printf 'export const x = 1\n' > apps/web/src/x.ts
  : > apps/web/node_modules/.keep

  mkdir -p nix/guest/base nix/hosts nix/edge nix/overlay/agents infra/azure
  printf '{ }\n' > nix/guest/base/boot.nix
  printf '{ }\n' > nix/hosts/default.nix
  printf '{ }\n' > nix/edge/default.nix
  printf '{ }\n' > nix/overlay/agents/claude.nix
  printf '{ }\n' > nix/packages.nix
  printf '{ "nodes": {} }\n' > nix/flake.lock
  # flake.nix with the two regions the real one has: the outputs a deploy
  # installs, and the checks a gate evaluates.
  cat > nix/flake.nix <<'EOF'
{
  outputs = { self, nixpkgs }:
    let system = "x86_64-linux"; in {
      nixosConfigurations.host-01 = { };
      nixosConfigurations.edge = { };

      packages.${system} = {
        guest-system = "guest";
      };

      checks.${system} = {
        guest-closure-size = ''
          echo "guest system closure"
        '';
        guest-session-survives-switch = ''
          echo "no session unit restarts"
        '';
      };

      devShells.${system} = { };
    };
}
EOF
  printf 'resource "azurerm_resource_group" "r" {}\n' > infra/azure/main.tf

  mkdir -p docs ops/dev
  printf 'docs/DECISIONS.md merge=union\n' > .gitattributes
  cat > docs/DECISIONS.md <<'EOF'
# Decisions

## Made during implementation

**I-100. The first entry.** (fixture) Text.

**I-101..I-103. A range header names both ends.** (fixture) Text.
EOF
  printf '# Decisions index\n' > docs/DECISIONS-INDEX.md
  cp "$repo/ops/dev/release-queue" ops/dev/release-queue
  cp "$repo/ops/dev/decisions-index.py" ops/dev/decisions-index.py
  chmod +x ops/dev/release-queue
  git add -A
  git commit -qm "the fixture repository"
}

# branch <clone> <name> [from]: a worktree of the clone on a new branch.
branch() { # clone name [from]
  local c=$1 b=$2 from=${3:-main}
  git -C "$root/$c" worktree add -q -b "$b" "$root/$c-$b" "$from"
  echo "$root/$c-$b"
}
# commit <dir> <message>
commit() { git -C "$1" add -A && git -C "$1" commit -qm "$2"; }
# field_of <entry file> <key>: what release-queue's own field() would read
field_of() { sed -n "s/^$2=//p" "$1" | head -n1; }
# state <clone>: the clone's queue state directory
state_of() { git -C "$root/$1" rev-parse --path-format=absolute --git-common-dir; }
# cut_release <clone>: the release id the one cut in this world made
cut_release() { local d; d=$(state_of "$1")/release-queue/releases; (cd "$d" && printf '%s\n' r* | head -1); }

# ------------------------------------------------------------- needs: targets

# needs_line <add output> prints what `add` said the branch ships as.
needs_line() { sed -n 's/.*ships as: \(.*\))$/\1/p' <<<"$1"; }

t_needs_go_shared_package() {
  local wt; wt=$(branch woker shared-pkg)
  echo 'const More = 1' >> "$wt/internal/shared/shared.go"
  commit "$wt" "shared"
  assert_eq "a change to internal/shared" "$(needs_line "$(q "$wt" add)")" "api,host"
}

t_needs_cli_only() {
  local wt; wt=$(branch woker cli-pkg)
  echo 'const More = 1' >> "$wt/internal/clipkg/clipkg.go"
  commit "$wt" "cli"
  assert_eq "a change only cmd/repose imports" "$(needs_line "$(q "$wt" add)")" "cli"
}

t_needs_embedded_file() {
  local wt; wt=$(branch woker mail-template)
  echo 'Welcome again.' >> "$wt/internal/api/mail/welcome.txt"
  commit "$wt" "mail"
  assert_eq "a non-Go file under a package" "$(needs_line "$(q "$wt" add)")" "api"
}

t_needs_web() {
  local wt; wt=$(branch woker web-copy)
  echo 'export const y = 2' >> "$wt/apps/web/src/x.ts"
  commit "$wt" "web"
  assert_eq "a change under apps/web" "$(needs_line "$(q "$wt" add)")" "web"
}

t_needs_guest_nix() {
  local wt; wt=$(branch woker guest-nix)
  echo '# a guest module' >> "$wt/nix/guest/base/boot.nix"
  commit "$wt" "guest nix"
  assert_eq "a change under nix/guest" "$(needs_line "$(q "$wt" add)")" "base"
}

t_needs_shared_nix() {
  local wt; wt=$(branch woker shared-nix)
  echo '# the package set' >> "$wt/nix/packages.nix"
  commit "$wt" "packages.nix"
  assert_eq "a change to the shared package set" "$(needs_line "$(q "$wt" add)")" "base,edge,host"
}

# A package whose changed files are all _test.go reaches no binary: go does
# not compile a test file into one. internal/edge is in cmd/gateway's deps,
# so a change to its test alone is charged an edge switch -- the owner's,
# and on a gateway that is byte-identical (the cpu-weight lane, 2026-10-15).
t_needs_ignores_a_test_only_change() {
  local wt; wt=$(branch woker test-only)
  echo '// another case' >> "$wt/internal/edge/edge_test.go"
  commit "$wt" "a test"
  assert_eq "a _test.go-only change" "$(needs_line "$(q "$wt" add)")" "none"
}

t_needs_docs_only() {
  local wt; wt=$(branch woker docs-only)
  echo 'A note.' >> "$wt/docs/DECISIONS.md"
  commit "$wt" "docs"
  assert_eq "a docs-only branch" "$(needs_line "$(q "$wt" add)")" "none"
}

# dev-tool-guards (6950361a) changed a comment and an awk script inside
# checks.guest-closure-size and was queued as base,edge,host -- a base
# publish and two switches, both the owner's. Comparing the derivation
# graphs says all three systems are byte-identical, so the targets are
# dropped. Here the comparison is stubbed; the real one is checked against
# this repository (docs/research/queue-revamp-plan.md §1).
# The same change when the comparison says the system DOES change: the
# target stays. Guards against a narrowing that drops a real deploy.
t_needs_keeps_a_target_the_comparison_confirms() {
  local wt; wt=$(branch woker real-guest-change)
  echo '# a real guest module change' >> "$wt/nix/guest/base/boot.nix"
  commit "$wt" "guest"
  local o; o=$(cd "$wt" && REPOSE_FIXTURE_EQUIV_CHANGED=1 PATH="$root/bin:$PATH" \
    REPOSE_QUEUE_EQUIV="$root/bin/equiv-stub" ops/dev/release-queue add 2>&1)
  assert_eq "a confirmed change keeps its target" "$(needs_line "$o")" "base"
}

# --fast, and a box with no nix (every repose guest), keep the path answer
# and record that it was not checked: a wrong "nothing to deploy" is worse
# than a wide one.
t_fast_records_that_it_did_not_check() {
  local wt; wt=$(branch woker fast-path)
  echo '# a guest module' >> "$wt/nix/guest/base/boot.nix"
  commit "$wt" "guest"
  local o; o=$(cd "$wt" && REPOSE_QUEUE_FAST=1 PATH="$root/bin:$PATH" \
    REPOSE_QUEUE_EQUIV="$root/bin/equiv-stub" ops/dev/release-queue add 2>&1)
  assert_eq "--fast keeps the path answer" "$(needs_line "$o")" "base" || return 1
  local s; s=$(state_of woker)/release-queue
  assert_has "and records that it did not check" "$(cat "$s/entries/fast-path")" "exact=no"
}

t_needs_drops_a_target_whose_system_is_unchanged() {
  local wt; wt=$(branch woker flake-checks)
  python3 - "$wt/nix/flake.nix" <<'PY'
import sys
p = sys.argv[1]
s = open(p).read()
s = s.replace('echo "guest system closure"', 'echo "guest system closure"\n          # a comment inside the check')
open(p, "w").write(s)
PY
  commit "$wt" "the closure gate prints the paths"
  local o; o=$(cd "$wt" && REPOSE_FIXTURE_EQUIV_SAME=1 PATH="$root/bin:$PATH" \
    REPOSE_QUEUE_EQUIV="$root/bin/equiv-stub" ops/dev/release-queue add 2>&1)
  assert_eq "a target whose system is unchanged is dropped" "$(needs_line "$o")" "none"
}

# A gate installs nothing, and this needs no comparison at all: the VM
# tests and the fragment checks are evaluated and deployed nowhere.
t_needs_gate_paths_ship_nothing() {
  local wt; wt=$(branch woker gate-paths)
  mkdir -p "$wt/nix/guest/tests" "$wt/nix/hosts/tests"
  echo '# a guest VM test' >> "$wt/nix/guest/tests/default.nix"
  echo '# a host VM test' >> "$wt/nix/hosts/tests/default.nix"
  echo '# a fragment check' >> "$wt/nix/guest/checks.nix"
  commit "$wt" "gates"
  assert_eq "a gate-only branch" "$(needs_line "$(q "$wt" add)")" "none"
}

# P5. `needs` and the commit count are read against refs/heads/main, which
# on woker-1 was 132 commits behind origin/main on 2026-10-15. This branch
# ships one CLI commit; against a stale main it claims everything that
# landed meanwhile.
t_needs_against_stale_local_main() {
  # origin moves ahead with a host change; woker's refs/heads/main does not.
  local other; other=$(branch kanali host-change)
  echo '# a host module' >> "$other/nix/hosts/default.nix"
  commit "$other" "hosts"
  git -C "$other" push -q origin "HEAD:refs/heads/main"
  git -C "$other" push -q origin "HEAD:refs/heads/integrated"
  git -C "$root/woker" fetch -q origin

  local wt; wt=$(branch woker late-cli refs/remotes/origin/integrated)
  echo 'const More = 1' >> "$wt/internal/clipkg/clipkg.go"
  commit "$wt" "cli"
  local o; o=$(q "$wt" add)
  assert_eq "ships as" "$(needs_line "$o")" "cli" || return 1
  assert_has "the commit count" "$o" "(1 commits" || return 1
}

# -------------------------------------------------------------------- ids

t_id_sees_local_branch() {
  local wt; wt=$(branch woker took-id)
  printf '\n**I-200. Taken on a branch.** (fixture) Text.\n' >> "$wt/docs/DECISIONS.md"
  commit "$wt" "I-200"
  local wt2; wt2=$(branch woker other)
  assert_eq "the next id after I-200 on another branch" "$(q "$wt2" id)" "I-201"
}

t_id_sees_range_header() {
  # the seed has **I-101..I-103, so 104 is next
  local wt; wt=$(branch woker ranged)
  assert_eq "both ends of a range header count" "$(q "$wt" id)" "I-104"
}

t_id_sees_remote_tracking() {
  local other; other=$(branch kanali remote-id)
  printf '\n**I-300. Integrated elsewhere.** (fixture) Text.\n' >> "$other/docs/DECISIONS.md"
  commit "$other" "I-300"
  git -C "$other" push -q origin "HEAD:refs/heads/integrated"
  git -C "$root/woker" fetch -q origin
  local wt; wt=$(branch woker after-fetch)
  assert_eq "an id only on origin/integrated" "$(q "$wt" id)" "I-301"
}

t_id_sees_uncommitted_worktree() {
  local wt; wt=$(branch woker uncommitted)
  printf '\n**I-400. Written, not committed.** (fixture) Text.\n' >> "$wt/docs/DECISIONS.md"
  local wt2; wt2=$(branch woker asker)
  assert_eq "an id in a working copy" "$(q "$wt2" id)" "I-401"
}

t_id_hands_out_several() {
  local wt; wt=$(branch woker several)
  assert_eq "three ids" "$(q "$wt" id 3 | paste -sd' ')" "I-104 I-105 I-106"
}

t_id_refuses_used_number() {
  # a reservation below an entry id must not be handed out again: plant a
  # reservation for I-104 and an entry for I-105, so arithmetic that
  # trusts the reservations alone would offer I-105.
  local wt; wt=$(branch woker clash)
  printf '\n**I-105. Already an entry.** (fixture) Text.\n' >> "$wt/docs/DECISIONS.md"
  commit "$wt" "I-105"
  local s; s=$(state_of woker)/release-queue
  echo "I-104 someone 2026-10-15" >> "$s/ids"
  assert_eq "the next id skips the entry" "$(q "$wt" id)" "I-106"
}

# P1. The reservations file lives in each machine's own git dir, so an id
# reserved on kanali is invisible on woker-1 until it reaches a shared
# ref. I-718, I-719, I-732 and I-740 were each handed out twice this way.
t_id_sees_other_machine_reservation() {
  local there; there=$(branch kanali reserving)
  local got_there; got_there=$(q "$there" id)
  assert_eq "kanali reserves" "$got_there" "I-104" || return 1
  local here; here=$(branch woker asking)
  local got_here; got_here=$(q "$here" id)
  [ "$got_here" != "$got_there" ] || { note "woker handed out $got_here, which kanali already holds"; return 1; }
  assert_eq "woker's next id" "$got_here" "I-105"
}

