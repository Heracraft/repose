  local wt; wt=$(branch woker shared-pkg)
  echo 'const More = 1' >> "$wt/internal/shared/shared.go"
  commit "$wt" "shared"
  assert_eq "a change to internal/shared" "$(needs_line "$(q "$wt" add)")" "api,host"
}

t_needs_cli_only() {
  local wt; wt=$(branch woker cli-pkg)
  echo 'const More = 1' >> "$wt/internal/clipkg/clipkg.go"
  commit "$wt" "cli"
  assert_eq "a change only cmd/repose imports" "$(needs_line "$(q "$wt" add)")" "cli"
}

t_needs_embedded_file() {
  local wt; wt=$(branch woker mail-template)
  echo 'Welcome again.' >> "$wt/internal/api/mail/welcome.txt"
  commit "$wt" "mail"
  assert_eq "a non-Go file under a package" "$(needs_line "$(q "$wt" add)")" "api"
}

t_needs_web() {
  local wt; wt=$(branch woker web-copy)
  echo 'export const y = 2' >> "$wt/apps/web/src/x.ts"
  commit "$wt" "web"
  assert_eq "a change under apps/web" "$(needs_line "$(q "$wt" add)")" "web"
}

t_needs_guest_nix() {
  local wt; wt=$(branch woker guest-nix)
  echo '# a guest module' >> "$wt/nix/guest/base/boot.nix"
  commit "$wt" "guest nix"
  assert_eq "a change under nix/guest" "$(needs_line "$(q "$wt" add)")" "base"
}

t_needs_shared_nix() {
  local wt; wt=$(branch woker shared-nix)
  echo '# the package set' >> "$wt/nix/packages.nix"
