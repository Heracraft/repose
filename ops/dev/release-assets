#!/usr/bin/env bash
# Every URL the shipped CLI fetches on a customer's machine answers 200 to
# a client with no credentials: the Mac's manifest-darwin.json at the
# hostd release the CLI pins, its signature against the release key, and
# the bundle it names against its checksum (I-1686), the CLI release that releases/latest resolves
# to (checksums.txt, its signature against the release key, the four
# archives) and install.sh. And what hosts fetch: the erofs guest base
# release guest-<version> (amd64- and arm64- vmlinuz, initramfs.img,
# rootfs.erofs, manifest.json, and SHA256SUMS; a bundle file over GitHub's
# 2 GiB asset cap is published as <name>.part0, .part1, ... and every part
# SHA256SUMS lists must answer) and the newest hostd-<version> release's
# manifest.json with the binaries it names (I-1500, I-1496). Exit 1 when any does
# not, with the asset and the fix named. DECISIONS I-1398; docs/ops/RELEASE.md.
#
# The check is TestReleaseAssetsAnswerAnonymously in internal/cli, so the
# URLs are the constants the code fetches, not a list kept here.
#
#   ops/dev/release-assets                      what this checkout pins, the latest CLI release, install.sh
#   ops/dev/release-assets --cli none           the Mac's bundle only (release-queue add; release.yml before the publish)
#   ops/dev/release-assets --cli v0.1.51        that tag's assets, and that releases/latest resolves to it
#   ops/dev/release-assets --mac 2026.11.18.1   a Mac bundle version other than the one the code pins (to see it red)
#   ops/dev/release-assets --install none       skip install.sh (a checkout whose web deploy is not live)
#   ops/dev/release-assets --mac none           skip the Mac's manifest and bundle
#   ops/dev/release-assets --guest 2026.11.22.1 that guest base release; the default is the newest
#                                               guest-* release (gh release list), since the base
#                                               version is a database row, not a constant
#   ops/dev/release-assets --hostd 2026.11.22.2 that hostd release; the default is the newest
#                                               hostd-* release with a manifest.json, as a host finds it
#   ops/dev/release-assets --guest none --hostd none   only what the CLI fetches (release-queue add, release.yml)
set -euo pipefail

usage() {
  sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2
  exit 2
}

mac="" cli="" install="" guest="" hostd=""
while [ $# -gt 0 ]; do
  case $1 in
    --mac) mac=${2:?}; shift 2 ;;
    # The design 1 appliance image is gone (I-1684); its flag is accepted
    # for one release and checks nothing.
    --appliance) shift 2 ;;
    --guest) guest=${2:?}; shift 2 ;;
    --hostd) hostd=${2:?}; shift 2 ;;
    --cli) cli=${2:?}; shift 2 ;;
    --install) install=${2:?}; shift 2 ;;
    -h | --help) usage ;;
    *) echo "release-assets: unknown argument $1" >&2; usage ;;
  esac
done

command -v go >/dev/null || { echo "release-assets: go is not on PATH; run it in the dev shell (nix develop ./nix)" >&2; exit 1; }
top=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
cd "$top"

if [ -z "$guest" ]; then
  # The newest guest-* release, published or not to customers: gh lists
  # newest first. The lookup reads the API with gh's credentials; the
  # assets themselves are fetched anonymously by the test.
  command -v gh >/dev/null || { echo "release-assets: gh is not on PATH, so the newest guest-* release cannot be found; pass --guest <version> or --guest none" >&2; exit 1; }
  tags=$(gh release list --repo Heracraft/repose --limit 200 --json tagName --jq '.[].tagName') ||
    { echo "release-assets: gh release list failed; pass --guest <version> or --guest none" >&2; exit 1; }
  guest=$(printf '%s\n' "$tags" | sed -n 's/^guest-//p' | head -1)
  guest=${guest:-unpublished}
fi

if [ -z "$hostd" ]; then
  # The release an owned host's updater picks (I-1496): the newest
  # non-draft hostd-<version> that carries a manifest.json, in version
  # order. hostd-stable is a dead name.
  command -v gh >/dev/null || { echo "release-assets: gh is not on PATH, so the newest hostd-* release cannot be found; pass --hostd <version> or --hostd none" >&2; exit 1; }
  hostd=$(gh api 'repos/Heracraft/repose/releases?per_page=100' \
    --jq '.[] | select((.draft | not) and (.tag_name | test("^hostd-[0-9]")) and any(.assets[]?; .name == "manifest.json")) | .tag_name' |
    sed 's/^hostd-//' | sort -V | tail -1) ||
    { echo "release-assets: the releases lookup failed; pass --hostd <version> or --hostd none" >&2; exit 1; }
  hostd=${hostd:-unpublished}
fi

out=$(mktemp)
trap 'rm -f "$out"' EXIT
set +e
env REPOSE_RELEASE_ASSETS=1 \
  ${mac:+REPOSE_RELEASE_ASSETS_MAC="$mac"} \
  ${cli:+REPOSE_RELEASE_ASSETS_CLI="$cli"} \
  ${install:+REPOSE_RELEASE_ASSETS_INSTALL="$install"} \
  REPOSE_RELEASE_ASSETS_GUEST="$guest" \
  REPOSE_RELEASE_ASSETS_HOSTD="$hostd" \
  go test ./internal/cli -run '^TestReleaseAssetsAnswerAnonymously$' -count=1 -v >"$out" 2>&1
rc=$?
set -e
# The lines the test prints, without go test's framing; everything when
# the build itself failed, since then the framing is the message.
if grep -q '^=== RUN' "$out"; then
  grep -v -E '^(=== RUN|--- (PASS|FAIL)|PASS$|FAIL$|ok[[:space:]]|FAIL[[:space:]])' "$out" |
    sed -E 's/^[[:space:]]+releaseassets_test\.go:[0-9]+: /FAIL /' || true
else
  cat "$out"
fi
exit $rc
