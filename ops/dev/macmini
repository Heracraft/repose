#!/usr/bin/env bash
# Rent a Scaleway Mac mini M4 for the nested-KVM measurement, drive it,
# and give it back. docs/research/mac-mini-nested-kvm.md §5.
#
#   ops/dev/macmini create      rent an M4-S in fr-par-1, no commitment (24 h minimum)
#   ops/dev/macmini wait        until Scaleway says ready and sshd answers
#   ops/dev/macmini status      state, ip, deletable_at, the ssh command
#   ops/dev/macmini ssh [cmd]   m1@<ip>
#   ops/dev/macmini bootstrap   copy and run ops/dev/macmini-bootstrap.sh on the Mac
#   ops/dev/macmini results     copy ~/repose-lab/results/ back into docs/research/
#   ops/dev/macmini destroy     delete; refuses before deletable_at unless --force
#
# Needs scw and jq (nix develop ./nix#infra) and the operator's Scaleway
# API key in the shell: SCW_ACCESS_KEY, SCW_SECRET_KEY,
# SCW_DEFAULT_PROJECT_ID (console.scaleway.com/iam/api-keys; a policy with
# AppleSiliconFullAccess and IAMManager on one project). The key is an
# operator secret like CLOUDFLARE_API_TOKEN in infra/README.md: shell
# only, never a file in this repository.
#
# Knobs: MACMINI_NAME (repose-macmini-lab), MACMINI_TYPE (M4-S),
# MACMINI_ZONE (fr-par-1), MACMINI_OS (an `os list` name or label;
# unset means Scaleway's default, which is the one that delivers fastest),
# MACMINI_SSH_PUBKEY (~/.ssh/id_ed25519.pub).
#
# UNTESTED as of 2026-11-19: written before the account existed. The
# first run is the test; fix what breaks and drop this line.
set -euo pipefail

NAME=${MACMINI_NAME:-repose-macmini-lab}
TYPE=${MACMINI_TYPE:-M4-S}
ZONE=${MACMINI_ZONE:-fr-par-1}
PUBKEY=${MACMINI_SSH_PUBKEY:-$HOME/.ssh/id_ed25519.pub}
KNOWN_HOSTS=$HOME/.ssh/known_hosts_macmini
HERE=$(cd "$(dirname "$0")" && pwd)
REPO=$(cd "$HERE/../.." && pwd)
DATA_DIR=$REPO/docs/research/mac-mini-nested-kvm-data

usage() { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 64; }
die() { echo "macmini: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "$1 is not on PATH (nix develop ./nix#infra)"; }
need scw; need jq

# One server, found by name; the id is never written anywhere, so a lost
# shell loses nothing.
server_id() {
  scw apple-silicon server list zone="$ZONE" -o json \
    | jq -r --arg n "$NAME" '.[] | select(.name == $n) | .id' | head -n1
}
server_json() {
  local id; id=$(server_id)
  [ -n "$id" ] || die "no server named $NAME in $ZONE (ops/dev/macmini create)"
  scw apple-silicon server get "$id" zone="$ZONE" -o json
}
field() { server_json | jq -r "$1"; }

ssh_opts() {
  echo -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$KNOWN_HOSTS" -o ConnectTimeout=10
}

ensure_ssh_key() {
  [ -r "$PUBKEY" ] || die "no public key at $PUBKEY (MACMINI_SSH_PUBKEY)"
  local key; key=$(cut -d' ' -f1,2 < "$PUBKEY")
  if scw iam ssh-key list -o json | jq -e --arg k "$key" 'map(select(.public_key | startswith($k))) | length > 0' >/dev/null; then
    return
  fi
  echo "uploading $PUBKEY to the project as $(hostname)-macmini"
  scw iam ssh-key create name="$(hostname)-macmini" public-key="$(cat "$PUBKEY")" >/dev/null
}

cmd_create() {
  if [ -n "$(server_id)" ]; then
    echo "$NAME already exists in $ZONE"; cmd_status; return
  fi
  ensure_ssh_key
  local os_arg=()
  if [ -n "${MACMINI_OS:-}" ]; then
    local os_id
    os_id=$(scw apple-silicon os list server-type="$TYPE" zone="$ZONE" -o json \
      | jq -r --arg n "$MACMINI_OS" '.[] | select(.name == $n or .label == $n) | .id' | head -n1)
    [ -n "$os_id" ] || die "no OS named $MACMINI_OS for $TYPE; see: scw apple-silicon os list server-type=$TYPE zone=$ZONE"
    os_arg=(os-id="$os_id")
    echo "note: a non-default OS adds about an hour before the Mac is delivered"
  fi
  echo "renting $TYPE in $ZONE as $NAME (24 h minimum under Apple's licence)"
  scw apple-silicon server create name="$NAME" type="$TYPE" zone="$ZONE" \
    commitment-type=none "${os_arg[@]}" -o json \
    | jq -r '"id \(.id)\nstatus \(.status)\ndeletable_at \(.deletable_at)"'
}

cmd_wait() {
  local id; id=$(server_id); [ -n "$id" ] || die "nothing to wait for"
  echo "waiting for Scaleway to deliver $NAME (fast path about 10 min, non-default OS about 1 h)"
  scw apple-silicon server wait "$id" zone="$ZONE" timeout=2h >/dev/null
  local ip user; ip=$(field .ip); user=$(field .ssh_username)
  echo "status $(field .status), delivered $(field .delivered), ip $ip"
  echo "waiting for sshd"
  for _ in $(seq 1 60); do
    # shellcheck disable=SC2046
    if ssh $(ssh_opts) -o BatchMode=yes "$user@$ip" true 2>/dev/null; then
      echo "ssh $user@$ip answers"; return
    fi
    sleep 10
  done
  die "sshd did not answer in 10 min; check the console (fail2ban clears only on a console reboot)"
}

cmd_status() {
  server_json | jq -r '
    "name         \(.name)",
    "type         \(.type)  os \(.os.label // .os.name // "default")",
    "status       \(.status)  delivered \(.delivered)",
    "ip           \(.ip)",
    "deletable_at \(.deletable_at)  scheduled \(.deletion_scheduled)",
    "ssh          ssh \(.ssh_username)@\(.ip)",
    "vnc          \(.vnc_url // "")"'
}

cmd_ssh() {
  local ip user; ip=$(field .ip); user=$(field .ssh_username)
  # shellcheck disable=SC2046
  exec ssh $(ssh_opts) "$user@$ip" "$@"
}

cmd_bootstrap() {
  local ip user; ip=$(field .ip); user=$(field .ssh_username)
  # shellcheck disable=SC2046
  scp $(ssh_opts) "$HERE/macmini-bootstrap.sh" "$user@$ip:macmini-bootstrap.sh"
  # shellcheck disable=SC2046
  ssh $(ssh_opts) -t "$user@$ip" 'chmod +x macmini-bootstrap.sh && ./macmini-bootstrap.sh'
}

cmd_results() {
  local ip user; ip=$(field .ip); user=$(field .ssh_username)
  mkdir -p "$DATA_DIR"
  # shellcheck disable=SC2046
  scp -r $(ssh_opts) "$user@$ip:repose-lab/results/." "$DATA_DIR/"
  echo "results in $DATA_DIR"; ls -1 "$DATA_DIR"
}

cmd_destroy() {
  local id; id=$(server_id); [ -n "$id" ] || die "no server named $NAME"
  local at now
  at=$(field .deletable_at)
  now=$(date -u +%s)
  if [ "$at" != "null" ] && [ "$(date -u -d "$at" +%s)" -gt "$now" ] && [ "${1:-}" != "--force" ]; then
    die "deletable from $at (Apple's 24 h minimum); run again then, or --force to try anyway"
  fi
  echo "deleting $NAME ($id); Scaleway takes about 30 min to finish, billing stops at the request"
  scw apple-silicon server delete "$id" zone="$ZONE"
}

case "${1:-}" in
  create)    cmd_create ;;
  wait)      cmd_wait ;;
  status)    cmd_status ;;
  ssh)       shift; cmd_ssh "$@" ;;
  bootstrap) cmd_bootstrap ;;
  results)   cmd_results ;;
  destroy)   shift; cmd_destroy "$@" ;;
  *)         usage ;;
esac
