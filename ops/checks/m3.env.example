# Copy to ops/checks/m3.env (git-ignored) and fill in. Nothing here is a
# secret: addresses, a slug and container names. The checks read it through
# lib.sh; the same names can come from the environment instead.

# The `repose` CLI, logged in as the account the checks run as (the owner).
REPOSE=repose
API_URL=https://api.repose.herakraft.co/v1

# The edge's public address and its operator sshd (nix/edge/edge-01.nix,
# infra edge_operator_ssh_port). This machine's address must be in
# operator_cidrs.
EDGE=20.102.98.254
EDGE_SSH_PORT=2222

# host-01's WireGuard address (`repose-admin hosts list`, the wg_ip column;
# 10.255.0.x). Operators reach the host only through the edge.
HOST_WG_IP=10.255.0.2

# The control VM's public address (operator sshd on 22, infra
# `control_public_ip`). repose-admin runs inside the api container there.
CONTROL_IP=

# The project the checks create and use (`repose run NAME` from an empty
# directory, or an existing one). secrets.sh, menu.sh, notifications.sh and
# resilience.sh all work on it; isolation-host01.sh needs a second user's
# project too (see that script).
PROJECT=m3-check

# Optional: pin the containers instead of discovering them by image.
#API_CTR=
#API_GRPC_CTR=
#PG_CTR=

# Where the evidence files go (default ops/checks/out, git-ignored).
#OUT=

# notifications.sh: the owner's ntfy URL (asked through the conductor).
#NTFY_URL=

# resilience.sh: a second, held project, and the git revision to publish as
# the next base (a rev of main with a kernel change for the kernel_changed
# row; see README.md).
#PROJECT_HELD=m3-held
#BASE_REV=38d1cbf   # the kernel-flip test base (README.md); a main sha otherwise
