# The `api` Coolify application (Dockerfile cmd/api/Dockerfile, DECISIONS
# I-2, I-87): every variable it reads, with production values. Paste into
# the app's Environment tab (developer view); secrets stay there, never in
# a file. api-grpc.env.example is the sibling app; web.env.example the
# dashboard. Rolling deploy: Coolify uses the image's HEALTHCHECK
# (`api -healthcheck`), so leave Coolify's own health check off.

API_MODE=http
API_LISTEN=:8080
API_METRICS_LISTEN=:9103      # port mapping 9103:9103; scraped over WireGuard, never public

# repose-postgres is the service name in ops/coolify/postgres/docker-compose.yml;
# that file joins the shared `coolify` network itself, which is what makes
# the name resolve here (docs/ops/coolify.md, fact 11). The password is
# deliberately not in
# the URL: Coolify resolves a {{project.X}} reference only when it is the
# variable's entire value, never inside a longer string (docs/ops/coolify.md,
# "Coolify facts"). pgx reads PGPASSWORD from the environment when the URL
# carries none, so the shared variable goes in on its own line.
DATABASE_URL=postgres://repose@repose-postgres:5432/repose?sslmode=disable
PGPASSWORD={{project.POSTGRES_PASSWORD}}
# The owner's existing Logto (DECISIONS I-84): the endpoint, without /oidc.
# The api appends /oidc for the issuer claim, /oidc/jwks and /oidc/token.
LOGTO_ISSUER=https://accounts.herakraft.co
LOGTO_M2M_CLIENT_ID=
LOGTO_M2M_CLIENT_SECRET=
API_RESOURCE=https://api.repose.herakraft.co

KEYVAULT_URL=https://repose-kv-3912.vault.azure.net/
KEYVAULT_KEY_NAME=repose-dek-wrap
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
BLOB_ACCOUNT_URL=https://reposesnapshots3912.blob.core.windows.net/
BLOB_CONTAINER=repose-snapshots

GATEWAY_HOST=ssh.repose.herakraft.co
GATEWAY_PORT=22

RESEND_API_KEY=
NOTIFY_FROM=repose <notify@repose.herakraft.co>
DASHBOARD_URL=https://repose.herakraft.co
OTEL_EXPORTER_OTLP_ENDPOINT=   # unset: no traces exported
LOG_LEVEL=info

# Billing (workstream 09, DECISIONS I-16, I-289 and I-604). With
# POLAR_ACCESS_TOKEN unset the api starts normally, every /billing route
# answers 503 billing_disabled and every start of a non-exempt account is
# refused with subscription_required; usage still accrues in usage_hours.
# With it set, the environment, the secret, the three products and the
# intro discount are required, or the api refuses to start rather than
# selling nothing. Do not fill the ids by hand: `ops/polar/bootstrap.sh`
# (repose-admin billing polar-bootstrap) creates the Polar objects from the
# token and prints this block. Polar's tokens do not say their environment,
# so POLAR_ENVIRONMENT names it.
POLAR_ACCESS_TOKEN=            # polar_oat_..., an organization access token
POLAR_ENVIRONMENT=             # sandbox or production
POLAR_WEBHOOK_SECRET=          # whsec_..., the webhook endpoint's secret
POLAR_PRODUCT_SOLO=            # $29 a month, 7-day trial, egress overage price
POLAR_PRODUCT_PLUS=            # $59 a month, 7-day trial, egress overage price
POLAR_PRODUCT_PRO=             # $99 a month, 7-day trial, egress overage price
POLAR_DISCOUNT_INTRO=          # Solo's introductory discount; a first Solo checkout carries it (I-497)
POLAR_PORTAL_RETURN_URL=       # defaults to DASHBOARD_URL/billing
SEATS_TOTAL=                   # seats the fleet sells (I-290); 0 or unset derives it from the hosts
BILLING_ENFORCE=true           # false keeps metering but blocks no start and stops no machine
                               # and stops no guest; every flip writes an audit_log row
SEATS_TOTAL=0                  # the fleet's seats (8 GB running at once each, DECISIONS I-290);
                               # 0 derives them from the ready hosts (30 on the launch D64s_v7).
                               # There is no off switch: a very large number is one.
                               # WAITLIST_PERCENT is ignored since I-290 and logged if set.

# No pre-deploy command. Coolify runs one with `docker exec` in the
# *previous* container and skips it when there is none, so the api applies
# its own migrations at start (API_MIGRATE, default 1) and generates the CA
# on the first start against an empty database; both are idempotent and
# replicas serialise on advisory locks (DECISIONS I-90). Set API_MIGRATE=0
# only on a replica that must never touch the schema.
