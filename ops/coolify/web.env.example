# The `web` Coolify application: Dockerfile apps/web/Dockerfile, domains
# https://repose.run:3000, https://www.repose.run:3000 and, while the old
# name keeps answering, https://repose.herakraft.co:3000 (3000 is the
# container port), health
# check path /healthz on 3000 (wget is in the image). Everything the app
# reads is PUBLIC_* at runtime; no rebuild to change these.

PUBLIC_API_URL=https://api.repose.run/v1
# The audience access tokens are asked for, and the api checks. It keeps the
# herakraft.co name after the move to repose.run: Logto identifies an API
# resource by this opaque string, not by where the api answers, and every
# installed CLI sends the same one (DECISIONS I-1156, I-1158). Unset, the
# dashboard falls back to PUBLIC_API_URL without its /v1.
PUBLIC_API_RESOURCE=https://api.repose.herakraft.co
PUBLIC_LOGTO_ENDPOINT=https://accounts.herakraft.co
PUBLIC_LOGTO_APP_ID=          # the repose-web SPA application in Logto
# No Polar value here: the api answers the hosted checkout's URL and the
# dashboard sends the browser there (DECISIONS I-182, I-604).
