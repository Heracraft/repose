# The `api-grpc` Coolify application: the same image as `api`
# (cmd/api/Dockerfile) in gRPC mode, hosts (hostd) on 8443 and the gateway's
# /internal on 8444, both mTLS from the CA in Postgres (DECISIONS I-42).
# Coolify port mappings: 8443:8443, 8444:8444, 10.255.255.1:9104:9103. None
# are open on the public IP; hosts reach 8443 on the VNet address
# (10.200.3.4, before they have a tunnel), the edge and Prometheus over
# WireGuard at the VM's 10.255.255.1 (DECISIONS I-92). The metrics port is
# bound to the WireGuard address alone: it is plain HTTP, so the VNet
# (edge, hosts) must not reach it (I-174, review M5-4). No domain, no pre-deploy command (`api`
# runs the migrations); deploy it after `api`. Health: the image's
# HEALTHCHECK (`api -healthcheck` probes the metrics listener in this mode).

API_MODE=grpc
API_GRPC_LISTEN=:8443
API_INTERNAL_LISTEN=:8444
API_METRICS_LISTEN=:9103

# The server certificate is issued from the api's CA at start for these
# names (I-87); an IP becomes an IP SAN. Hosts are registered with
# apiServerName = the first one and dial the VNet address; the gateway dials
# the WireGuard address by IP (I-92).
GRPC_SERVER_NAMES=api.repose.herakraft.co,10.255.255.1,10.200.3.4

DATABASE_URL=postgres://repose@repose-postgres:5432/repose?sslmode=disable
PGPASSWORD={{project.POSTGRES_PASSWORD}}   # whole-value reference only; see api.env.example

KEYVAULT_URL=https://repose-kv-3912.vault.azure.net/
KEYVAULT_KEY_NAME=repose-dek-wrap
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
BLOB_ACCOUNT_URL=https://reposesnapshots3912.blob.core.windows.net/
BLOB_CONTAINER=repose-snapshots

GATEWAY_HOST=ssh.repose.herakraft.co
GATEWAY_PORT=22

RESEND_API_KEY=
NOTIFY_FROM=repose <notify@repose.herakraft.co>
DASHBOARD_URL=https://repose.herakraft.co
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# Billing runs its hourly jobs (rollup, dunning, the egress overage line)
# from this process too (09, I-289, I-604): the same POLAR_* block as api.
POLAR_ACCESS_TOKEN=
POLAR_ENVIRONMENT=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_SOLO=
POLAR_PRODUCT_PLUS=
POLAR_PRODUCT_PRO=
POLAR_DISCOUNT_INTRO=
SEATS_TOTAL=
BILLING_ENFORCE=true
SEATS_TOTAL=0         # the invite tick runs here; keep it equal to the http app's (I-290)
